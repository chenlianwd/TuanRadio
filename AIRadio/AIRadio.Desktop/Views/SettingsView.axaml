<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="设置" FontSize="20" FontWeight="700" Foreground="#FFFFFFFF"/>

        <!-- API Key -->
        <StackPanel Spacing="6">
            <TextBlock Text="Minimax API Key" FontWeight="700" Foreground="#FFFFFFFF" FontSize="13"/>
            <TextBox Text="{Binding ApiKey, Mode=TwoWay}" Watermark="输入你的 API Key" PasswordChar="•"/>
            <Button Command="{Binding TestConnectionCommand}" Content="测试连接"
                    HorizontalAlignment="Left" Padding="18,8" FontSize="12" Background="#FF1ED760"
                    Foreground="#FF000000"/>
        </StackPanel>

        <!-- DJ Profile -->
        <StackPanel Spacing="6">
            <TextBlock Text="主播名称" FontWeight="700" Foreground="#FFFFFFFF" FontSize="13"/>
            <TextBox Text="{Binding DjName, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="主播描述" FontWeight="700" Foreground="#FFFFFFFF" FontSize="13"/>
            <TextBox Text="{Binding DjDescription, Mode=TwoWay}" AcceptsReturn="True" Height="60" CornerRadius="8"/>
        </StackPanel>

        <!-- Save -->
        <Button Command="{Binding SaveCommand}" Content="保存设置"
                HorizontalAlignment="Stretch" Padding="18,12" FontSize="14"
                Background="#FF1ED760" Foreground="#FF000000"/>

        <!-- Status -->
        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFB3B3B3"
                   TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
</UserControl>
