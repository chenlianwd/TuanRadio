<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel">

    <Border Background="#FF181818" CornerRadius="8" Padding="16,12">
        <StackPanel Spacing="12">
            <!-- Track info -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="14" FontWeight="700"
                               Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TrackArtist}" FontSize="11" Foreground="#FF808080"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Progress bar -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding PositionText}" VerticalAlignment="Center"
                           FontSize="10" Foreground="#FF808080" MinWidth="28"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TotalSeconds}"
                        Value="{Binding CurrentSeconds}"
                        Margin="8,0" VerticalAlignment="Center"
                        PointerReleased="OnSliderReleased" Height="4"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center"
                           FontSize="10" Foreground="#FF808080" MinWidth="28"/>
            </Grid>

            <!-- Transport controls -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                <!-- Shuffle -->
                <Button Grid.Column="0" Command="{Binding ToggleShuffleCommand}"
                        FontSize="12" Padding="8,6" CornerRadius="500"
                        VerticalAlignment="Center">
                    <Button.Background>
                        <Binding Path="IsShuffled" Converter="{StaticResource BoolToAccentBg}"/>
                    </Button.Background>
                    <TextBlock FontSize="11">
                        <TextBlock.Foreground>
                            <Binding Path="IsShuffled" Converter="{StaticResource BoolToAccentFg}"/>
                        </TextBlock.Foreground>
                        <Run Text="⇌"/>
                    </TextBlock>
                </Button>

                <!-- Center: Previous / Play / Next -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                    <Button Command="{Binding PreviousCommand}" FontSize="16" Padding="8"
                            Background="Transparent" CornerRadius="100">
                        <TextBlock Text="|◁" Foreground="#FFFFFFFF"/>
                    </Button>

                    <Button Command="{Binding PlayCommand}" FontSize="18" Padding="12"
                            CornerRadius="100" Background="#FF1ED760">
                        <TextBlock Text="{Binding PlayPauseText}" Foreground="#FF000000" FontWeight="Bold"/>
                    </Button>

                    <Button Command="{Binding NextCommand}" FontSize="16" Padding="8"
                            Background="Transparent" CornerRadius="100">
                        <TextBlock Text="▷|" Foreground="#FFFFFFFF"/>
                    </Button>
                </StackPanel>

                <!-- Repeat -->
                <Button Grid.Column="2" Command="{Binding ToggleRepeatCommand}"
                        FontSize="12" Padding="8,6" CornerRadius="500"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button.Background>
                        <Binding Path="RepeatMode" Converter="{StaticResource RepeatToBg}"/>
                    </Button.Background>
                    <TextBlock FontSize="11">
                        <TextBlock.Foreground>
                            <Binding Path="RepeatMode" Converter="{StaticResource RepeatToFg}"/>
                        </TextBlock.Foreground>
                        <Run Text="{Binding RepeatMode, Converter={StaticResource RepeatIcon}}"/>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- Volume -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Column="0" Text="♪" FontSize="12" VerticalAlignment="Center"
                           Foreground="#FF808080" Margin="0,0,6,0"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}"
                        SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Height="3"/>
                <TextBlock Grid.Column="2" FontSize="10" Foreground="#FF808080" Margin="6,0,0,0"
                           VerticalAlignment="Center" MinWidth="28">
                    <Run Text="{Binding Volume, Mode=OneWay, StringFormat={}{0:P0}}"/>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
