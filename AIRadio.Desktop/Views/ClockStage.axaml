<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.ClockStage"
             x:DataType="vm:MainWindowViewModel">

    <!-- 注意：环境指示器子树必须用 {Binding WeatherVM.X} 路径绑定——DataContext="{Binding WeatherVM}"
         重定向与"同页编译绑定"组合会静默破坏整个程序集的 XAML 预编译（ChatAreaMicButtonTests 回归锚定）。
         本文件 SpectrumView 的 DataContext="{Binding SpectrumVM}" 重定向是安全的：SpectrumView 自带
         x:DataType、其绑定在独立编译单元内编译，危险的是"重定向 + 本页作用域的编译绑定"混用 -->
    <UserControl.Styles>
        <!-- 中栏（时钟/歌词面板）手型光标仅在可点时提示（有在播曲目）：
             无曲目时点击静默，光标不得谎报可点；频谱列随时可点（切样式），恒手型。
             频谱列整列为命中区（SpectrumView 内透明命中层），不再依赖跳动的绘制几何 -->
        <Style Selector="StackPanel.clickable">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="StageRoot" Background="{DynamicResource C_F008080D}">
        <TextBlock x:Name="ClockDots"
                   IsHitTestVisible="False"
                   Opacity="0.20"
                   FontSize="11"
                   LineHeight="17"
                   FontFamily="Consolas"
                   Foreground="{DynamicResource C_FF44465C}"
                   TextWrapping="Wrap"/>
        <local:StarfieldView x:Name="Starfield"
                             IsHitTestVisible="False"/>
        <Grid x:Name="ClockLayer" ColumnDefinitions="*,Auto,*" Margin="24,10" IsVisible="{Binding !IsLyricsMode}">
            <local:SpectrumView x:Name="ClockSpectrumLeft" Grid.Column="0" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                Margin="0,0,18,0"/>
            <StackPanel x:Name="ClockPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                        Background="Transparent" Classes.clickable="{Binding HasCurrentTrack}">
                <TextBlock Text="{Binding Now, StringFormat='HH:mm'}" FontSize="56" FontWeight="700"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FFFFFFFF}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalizedDayOfWeek}" FontSize="13" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FFE5E5EC}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalizedDate}" FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FF858594}" HorizontalAlignment="Center"/>
            </StackPanel>
            <local:SpectrumView x:Name="ClockSpectrumRight" Grid.Column="2" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                Margin="18,0,0,0"/>
        </Grid>

        <!-- 环境指示器（天气）：时钟/歌词两种模式常显；默认仅图标，悬停出详情（日历徽标 2026-10-13 移除）。
             Transparent 命中层：指示器带落在频谱列整列命中区内，须自身吸收点击保持"无动作"契约，
             光标维持显式 Arrow（不被频谱列手型覆盖） -->
        <StackPanel x:Name="EnvironmentIndicators" Orientation="Horizontal" Spacing="12" Cursor="Arrow"
                    Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,10">
        <TextBlock Text="{Binding WeatherVM.WeatherGlyph}" FontSize="14"
                   FontFamily="Segoe UI Symbol, Microsoft YaHei UI"
                   Foreground="{DynamicResource C_FFB3B3B3}"
                   ToolTip.Tip="{Binding WeatherVM.WeatherTooltip}"
                   IsVisible="{Binding WeatherVM.IsWeatherVisible}"/>
    </StackPanel>

    <!-- 歌词图层：仅替换中栏时钟，两侧频谱与星空常驻（频谱/歌词共存）；
         中栏宽度由代码后置按舞台尺寸自适应（min(540, 可用宽×0.55)，见 OnStageSizeChanged），
         两次尺寸变化之间保持定值防逐行歌词长度变化带动频谱抖动；点击中栏面板切换（标题栏旧按钮已移除） -->
        <Grid x:Name="LyricsLayer" ColumnDefinitions="*,Auto,*" Margin="24,10" IsVisible="{Binding IsLyricsMode}">
            <local:SpectrumView x:Name="LyricsSpectrumLeft" Grid.Column="0" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                Margin="0,0,18,0"/>
            <StackPanel x:Name="LyricsPanel" Grid.Column="1" Background="Transparent"
                        Classes.clickable="{Binding HasCurrentTrack}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding LyricsVM.PreviousLineText}" FontSize="12" Opacity="0.7"
                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                <TextBlock Text="{Binding LyricsVM.CurrentLineText}" FontSize="19" FontWeight="700"
                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
                <TextBlock Text="{Binding LyricsVM.NextLineText}" FontSize="12" Opacity="0.7"
                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                <TextBlock Text="{Binding LyricsVM.LyricStatusText}" FontSize="10" Margin="0,6,0,0"
                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                           HorizontalAlignment="Center" IsVisible="{Binding LyricsVM.HasStatusText}"/>
            </StackPanel>
            <local:SpectrumView x:Name="LyricsSpectrumRight" Grid.Column="2" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                Margin="18,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
