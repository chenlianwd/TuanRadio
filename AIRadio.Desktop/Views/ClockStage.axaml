<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.ClockStage"
             x:DataType="vm:MainWindowViewModel">

    <!-- 环境指示器徽标样式：节气/节日当天高亮。
         注意：子树必须用 {Binding WeatherVM.X} 路径绑定——DataContext="{Binding WeatherVM}"
         重定向与编译绑定组合会静默破坏整个程序集的 XAML 预编译（ChatAreaMicButtonTests 回归锚定） -->
    <UserControl.Styles>
        <Style Selector="Border.calendar-badge">
            <Setter Property="Background" Value="{DynamicResource C_10000000}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_333A3D4A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,2"/>
        </Style>
        <Style Selector="Border.calendar-badge.highlighted">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Border.calendar-badge.highlighted TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="FontWeight" Value="700"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource C_F008080D}">
        <TextBlock x:Name="ClockDots"
                   IsHitTestVisible="False"
                   Opacity="0.20"
                   FontSize="11"
                   LineHeight="17"
                   FontFamily="Consolas"
                   Foreground="{DynamicResource C_FF44465C}"
                   TextWrapping="Wrap"/>
        <local:StarfieldView x:Name="Starfield"
                             IsHitTestVisible="False"/>
        <Grid ColumnDefinitions="*,Auto,*" Margin="24,10" IsVisible="{Binding !IsLyricsMode}">
            <local:SpectrumView Grid.Column="0" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Height="118" Margin="0,0,18,0"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Now, StringFormat='HH:mm'}" FontSize="56" FontWeight="700"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FFFFFFFF}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalizedDayOfWeek}" FontSize="13" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FFE5E5EC}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalizedDate}" FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FF858594}" HorizontalAlignment="Center"/>
            </StackPanel>
            <local:SpectrumView Grid.Column="2" DataContext="{Binding SpectrumVM}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Height="118" Margin="18,0,0,0"/>
        </Grid>

        <!-- 环境指示器（天气 + 日历徽标）：与时钟图层同显隐，歌词模式避让；默认仅图标，悬停出详情 -->
    <StackPanel Orientation="Horizontal" Spacing="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,10"
                IsVisible="{Binding !IsLyricsMode}">
        <Border Classes="calendar-badge" Classes.highlighted="{Binding WeatherVM.IsCalendarHighlighted}"
                ToolTip.Tip="{Binding WeatherVM.CalendarTooltip}">
            <TextBlock Text="{Binding WeatherVM.CalendarDayBadge}" FontSize="10" FontFamily="Consolas"
                       Foreground="{DynamicResource C_FFB3B3B3}"/>
        </Border>
        <TextBlock Text="{Binding WeatherVM.WeatherGlyph}" FontSize="14"
                   FontFamily="Segoe UI Symbol, Microsoft YaHei UI"
                   Foreground="{DynamicResource C_FFB3B3B3}"
                   ToolTip.Tip="{Binding WeatherVM.WeatherTooltip}"
                   IsVisible="{Binding WeatherVM.IsWeatherVisible}"/>
    </StackPanel>

    <!-- 歌词图层：与三栏时钟/频谱互斥；星空与 ClockDots 继续作为背景 -->
        <StackPanel IsVisible="{Binding IsLyricsMode}" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="48,0">
            <TextBlock Text="{Binding LyricsVM.PreviousLineText}" FontSize="12" Opacity="0.7"
                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540"/>
            <TextBlock Text="{Binding LyricsVM.CurrentLineText}" FontSize="19" FontWeight="700"
                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
            <TextBlock Text="{Binding LyricsVM.NextLineText}" FontSize="12" Opacity="0.7"
                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540"/>
            <TextBlock Text="{Binding LyricsVM.LyricStatusText}" FontSize="10" Margin="0,6,0,0"
                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF858594}"
                       HorizontalAlignment="Center" IsVisible="{Binding LyricsVM.HasStatusText}"/>
        </StackPanel>
    </Grid>
</UserControl>
