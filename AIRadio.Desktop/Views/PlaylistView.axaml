<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.PlaylistView"
             x:DataType="vm:PlaylistViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Tab header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,8">
            <Button Grid.Column="0" Command="{Binding ShowPlaylistCommand}" Padding="14,7" FontSize="12" FontWeight="600" CornerRadius="8,0,0,8"
                    Background="{Binding TabIndex, Converter={StaticResource TabBgPlaylistConverter}}">
                <TextBlock Text="列表"
                           Foreground="{Binding TabIndex, Converter={StaticResource TabFgPlaylistConverter}}"/>
            </Button>
            <Button Grid.Column="1" Command="{Binding ShowFavoritesCommand}" Padding="14,7" FontSize="12" FontWeight="600" CornerRadius="0"
                    Background="{Binding TabIndex, Converter={StaticResource TabBgFavoritesConverter}}">
                <TextBlock Text="♥ 收藏"
                           Foreground="{Binding TabIndex, Converter={StaticResource TabFgFavoritesConverter}}"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding ShowSearchCommand}" Padding="14,7" FontSize="12" FontWeight="600" CornerRadius="0,8,8,0"
                    Background="{Binding TabIndex, Converter={StaticResource TabBgSearchConverter}}">
                <TextBlock Text="搜索" Foreground="{Binding TabIndex, Converter={StaticResource TabFgSearchConverter}}"/>
            </Button>
            <Button Grid.Column="3" Content="＋" Click="OnImportFiles" FontSize="14" Padding="12,6" Background="Transparent" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Search bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8" IsVisible="{Binding TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
            <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="搜索歌曲..." Margin="0,0,6,0" KeyDown="OnSearchKeyDown"/>
            <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="搜索" Padding="14,8" Background="#FF1C1C1C"/>
        </Grid>

        <!-- Search results -->
        <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" IsVisible="{Binding TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}" SelectionMode="Single" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" Margin="0,1" Background="#FF1C1C1C" CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="600" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#FF666666" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="▶" FontSize="11" Padding="8,5" Margin="4,0" Background="Transparent"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).PlayOnlineCommand}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="2" Content="＋" FontSize="12" Padding="8,5" Background="Transparent"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).AddOnlineCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Favorites -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Favorites}" IsVisible="{Binding TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}" SelectionMode="Single" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" Margin="0,1" Background="#FF1C1C1C" CornerRadius="6">
                        <Grid ColumnDefinitions="32,*,Auto,Auto,Auto">
                            <Border Grid.Column="0" Background="#FF0D0D0D" CornerRadius="4" Width="28" Height="28">
                                <TextBlock Text="♥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFFF4444"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="600" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#FF666666"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}" VerticalAlignment="Center" Foreground="#FF666666" FontSize="11" Margin="6,0"/>
                            <Button Grid.Column="3" Content="▶" FontSize="10" Padding="6,3" Margin="2,0" Background="Transparent"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).PlayFavoriteCommand}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="4" Content="✕" FontSize="10" Padding="6,3" Background="Transparent" Foreground="#FF444444"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).RemoveTrackCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Playlist -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                 IsVisible="{Binding TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}" SelectionMode="Single" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" Margin="0,1" Background="#FF1C1C1C" CornerRadius="6">
                        <Grid ColumnDefinitions="32,*,Auto,Auto,Auto">
                            <Border Grid.Column="0" Background="#FF0D0D0D" CornerRadius="4" Width="28" Height="28">
                                <TextBlock Text="♪" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FF444444"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="600" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#FF666666"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}" VerticalAlignment="Center" Foreground="#FF666666" FontSize="11" Margin="6,0"/>
                            <Button Grid.Column="3" Content="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}" FontSize="11" Padding="6,3" Margin="2,0" Background="Transparent" Foreground="#FFFF4444"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="4" Content="✕" FontSize="10" Padding="6,3" Background="Transparent" Foreground="#FF444444"
                                    Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).RemoveTrackCommand}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
