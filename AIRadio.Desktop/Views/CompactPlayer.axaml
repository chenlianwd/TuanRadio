<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.CompactPlayer"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <LinearGradientBrush x:Key="MiniSpectrumPrimary" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="{DynamicResource C_FFB9FFE8}"/>
            <GradientStop Offset="1" Color="{DynamicResource C_FF56F5C4}"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- 音量按钮是全应用唯一 ToggleButton：Avalonia 类型选择器只匹配精确类型（headless 实证，
         Button 样式对 ToggleButton 不生效），MainWindow 的 Button 样式族覆盖不到它——Fluent 默认
         给未选中态半透明白浅底（视觉近似 hover）、选中态实心 Accent 填充（图标同为 AccentGreen，
         绿底绿字看不清字形）。在此补齐与 Button 家族同款基础视觉；checked（音量弹层展开）改用
         半透明强调色示"接合"（同 ChatArea 录音态描边语汇），不再吃 Fluent 实心 Accent。 -->
    <UserControl.Styles>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource C_11121620}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FFEDEDF5}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_333A3D4A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_24212632}"/>
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_3356F5C4}"/>
        </Style>
        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_6656F5C4}"/>
        </Style>
    </UserControl.Styles>

    <Border Margin="6" Background="{DynamicResource SurfaceShell}"
            BorderBrush="{DynamicResource BorderShell}" BorderThickness="1"
            CornerRadius="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*" Margin="12,6,12,8">

            <!-- 行1：状态点 + 曲目信息 + 收藏/置顶/展开/最小化/关闭；整行可拖动、双击还原 -->
            <Grid x:Name="InfoRow" MinHeight="30" Background="Transparent"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                  PointerPressed="OnDragAreaPressed" DoubleTapped="OnExpandDoubleTapped">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                    <Border.Background>
                        <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                            <Binding Path="CurrentState"/>
                            <Binding Path="IsDarkMode"/>
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <Panel x:Name="TrackInfoArea" Grid.Column="1" Margin="8,0,8,0" Background="Transparent"
                       Cursor="Hand"
                       AutomationProperties.Name="{DynamicResource S_CompactLyricsTip}"
                       PointerPressed="OnTrackInfoPressed" PointerMoved="OnTrackInfoMoved"
                       PointerReleased="OnTrackInfoReleased" PointerCaptureLost="OnTrackInfoCaptureLost"
                       DoubleTapped="OnExpandDoubleTapped">
                    <!-- 行内文字被截断时，悬停可看完整曲目信息；手势提示保留在最末行 -->
                    <ToolTip.Tip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{Binding PlayerVM.TrackTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PlayerVM.TrackArtist}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource C_FF9A9AA6}"/>
                            <TextBlock Text="{Binding PlayerVM.TrackQualityDetail}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource C_FF858594}"
                                       IsVisible="{Binding PlayerVM.HasQuality}"/>
                            <TextBlock Text="{Binding PlayerVM.TrackPreviewText}" FontSize="11"
                                       Foreground="{DynamicResource C_FF858594}"
                                       IsVisible="{Binding PlayerVM.TrackIsPreview}"/>
                            <TextBlock Text="{DynamicResource S_CompactLyricsTip}" Margin="0,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource C_FF858594}"/>
                        </StackPanel>
                    </ToolTip.Tip>
                    <!-- 子元素不参与命中测试：单击切换歌词会交换可见子元素，若命中源随之改变，
                         Avalonia 双击手势的同源校验（两次按下须命中同一元素）会失败，双击还原将失效 -->
                    <TextBlock Text="{Binding LyricsVM.CurrentLineText}"
                               IsVisible="{Binding IsCompactLyricsVisible}" IsHitTestVisible="False"
                               FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" FontWeight="600"
                               Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 默认曲目信息：歌名 + 歌手 -->
                    <DockPanel IsVisible="{Binding IsCompactLyricsVisible, Converter={StaticResource InverseBoolConverter}}"
                               IsHitTestVisible="False">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlayerVM.TrackArtist}"
                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource C_FF9A9AA6}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                        <TextBlock Text="{Binding PlayerVM.TrackTitle}"
                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" FontWeight="700"
                                   Foreground="{DynamicResource C_FFEDEDF5}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Panel>

                <Button Grid.Column="2" Width="26" Height="24" Padding="0"
                        Command="{Binding ToggleCurrentFavoriteCommand}" ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}">
                    <Grid>
                        <PathIcon Width="14" Height="14" IsVisible="{Binding IsCurrentFavorite, Converter={StaticResource InverseBoolConverter}}"
                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsCurrentFavorite}"
                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                    </Grid>
                </Button>
                <Button Grid.Column="3" Width="26" Height="24" Padding="0"
                        Command="{Binding ToggleCompactTopmostCommand}"
                        ToolTip.Tip="{DynamicResource S_TopMost}" AutomationProperties.Name="{DynamicResource S_TopMost}">
                    <Grid>
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource C_FF8A8A96}"
                                  IsVisible="{Binding SettingsVM.CompactModeTopmost, Converter={StaticResource InverseBoolConverter}}"
                                  Data="M16,9 V4 H17 C17.55,4 18,3.55 18,3 C18,2.45 17.55,2 17,2 H7 C6.45,2 6,2.45 6,3 C6,3.55 6.45,4 7,4 H8 V9 C8,10.66 6.66,12 5,12 V14 H10.97 V21 L12,22 L13,21 V14 H19 V12 C17.34,12 16,10.66 16,9 Z"/>
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource C_FF56F5C4}"
                                  IsVisible="{Binding SettingsVM.CompactModeTopmost}"
                                  Data="M16,9 V4 H17 C17.55,4 18,3.55 18,3 C18,2.45 17.55,2 17,2 H7 C6.45,2 6,2.45 6,3 C6,3.55 6.45,4 7,4 H8 V9 C8,10.66 6.66,12 5,12 V14 H10.97 V21 L12,22 L13,21 V14 H19 V12 C17.34,12 16,10.66 16,9 Z"/>
                    </Grid>
                </Button>
                <!-- 展开在最小化左侧：与 TitleBar 的“模式切换→最小化→关闭”顺序一致，关闭恒居最右 -->
                <Button Grid.Column="4" Width="26" Height="24" Padding="0"
                        Command="{Binding ToggleCompactModeCommand}"
                        ToolTip.Tip="{DynamicResource S_Expand}" AutomationProperties.Name="{DynamicResource S_Expand}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FF8A8A96}" StrokeThickness="2"
                          Data="M15,3 L21,3 L21,9 M9,21 L3,21 L3,15 M21,3 L14,10 M3,21 L10,14" Fill="Transparent" StrokeLineCap="Round"/>
                </Button>
                <Button Grid.Column="5" Width="26" Height="24" Padding="0" Click="OnMinimizeClicked"
                        ToolTip.Tip="{DynamicResource S_Minimize}" AutomationProperties.Name="{DynamicResource S_Minimize}">
                    <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource C_FF8A8A96}"/>
                </Button>
                <Button Grid.Column="6" Width="26" Height="24" Padding="0" Click="OnCloseClicked"
                        ToolTip.Tip="{DynamicResource S_Close}" AutomationProperties.Name="{DynamicResource S_Close}">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource C_FF8A8A96}" StrokeThickness="2"
                          Data="M5 5 L19 19 M5 19 L19 5" Fill="Transparent" StrokeLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 行2：上一首/播放/下一首 + 时间 + 进度 + 实际码率 + 迷你频谱 -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                <Button Width="28" Height="28" Padding="0" Command="{Binding PlayerVM.PreviousCommand}"
                        ToolTip.Tip="{DynamicResource S_Prev}" AutomationProperties.Name="{DynamicResource S_Prev}">
                    <PathIcon Width="14" Height="14" Data="M6,5 L6,19 M18,6 L9,12 L18,18 Z"/>
                </Button>
                <Button Grid.Column="1" Width="32" Height="28" Padding="0" Command="{Binding PlayerVM.PlayCommand}"
                        ToolTip.Tip="{DynamicResource S_PlayPause}" AutomationProperties.Name="{DynamicResource S_PlayPause}">
                    <Grid>
                        <PathIcon Width="13" Height="13" IsVisible="{Binding PlayerVM.IsPlaying, Converter={StaticResource InverseBoolConverter}}"
                                  Data="M8,5 L19,12 L8,19 Z"/>
                        <PathIcon Width="13" Height="13" IsVisible="{Binding PlayerVM.IsPlaying}"
                                  Data="M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z"/>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Command="{Binding PlayerVM.NextCommand}"
                        ToolTip.Tip="{DynamicResource S_Next}" AutomationProperties.Name="{DynamicResource S_Next}">
                    <PathIcon Width="14" Height="14" Data="M18,5 L18,19 M6,6 L15,12 L6,18 Z"/>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding PlayerVM.PositionText}" FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FF9A9AA6}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Slider Grid.Column="4" x:Name="CompactProgressSlider" MinHeight="12"
                        Minimum="0" Maximum="{Binding PlayerVM.TotalSeconds}"
                        Foreground="{DynamicResource AccentGreen}"
                        Value="{Binding PlayerVM.CurrentSeconds}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding PlayerVM.DurationText}" FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource C_FF9A9AA6}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- 音质品级短徽标：编码/码率/采样率/声道见曲目 Tooltip -->
                <TextBlock x:Name="CompactQualityBadge" Grid.Column="6" Text="{Binding PlayerVM.TrackQualityShort}" FontSize="9" FontFamily="Consolas, Microsoft YaHei UI"
                           Foreground="{DynamicResource C_FF9A9AA6}" VerticalAlignment="Center" Margin="0,0,6,0"
                           IsVisible="{Binding PlayerVM.HasQuality}"
                           ToolTip.Tip="{Binding PlayerVM.TrackQualityDetail}"/>
                <!-- 常驻仅一个音量按钮；点击后用轻量 Popup 展开横向滑杆。 -->
                <Panel Grid.Column="7" Margin="0,0,6,0">
                    <ToggleButton x:Name="CompactVolumeButton" Width="26" Height="26" Padding="0"
                                  ToolTip.Tip="{DynamicResource S_Volume}" AutomationProperties.Name="{DynamicResource S_Volume}">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentGreen}"
                              Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M15,9 C16.6,10.7 16.6,13.3 15,15 L16.8,16.8 C19.4,14.1 19.4,9.9 16.8,7.2 Z"/>
                    </ToggleButton>
                    <Popup IsOpen="{Binding #CompactVolumeButton.IsChecked, Mode=TwoWay}"
                           PlacementTarget="{Binding #CompactVolumeButton}"
                           Placement="Top" IsLightDismissEnabled="True" VerticalOffset="-6">
                        <Border Background="{DynamicResource SurfaceShell}" BorderBrush="{DynamicResource BorderShell}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Slider Width="130" Minimum="0" Maximum="1"
                                        Foreground="{DynamicResource AccentGreen}"
                                        Value="{Binding PlayerVM.Volume}"/>
                                <TextBlock Width="34" Text="{Binding PlayerVM.Volume, StringFormat={}{0:P0}}"
                                           FontSize="10" FontFamily="Consolas" TextAlignment="Right"
                                           Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>
                <!-- 迷你频谱：复用主舞台 SpectrumRenderer（四种样式同一绘制器），
                     StyleName 绑 SpectrumVM.SelectedStyle 与主界面实时同步；点击循环样式
                     （同主舞台频谱列手势）。透明命中层：纯自绘 Renderer 无可命中背景
                     （同 SpectrumView 2026-10-16 修复）；code-behind 订阅
                     SpectrumVM.SpectrumReceived 降采样 32→8 段喂 Renderer -->
                <Grid x:Name="CompactSpectrumHost" Grid.Column="8" Width="46" Height="20"
                      VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                      Tapped="OnSpectrumTapped">
                    <local:SpectrumRenderer x:Name="CompactSpectrum"
                                            StyleName="{Binding SpectrumVM.SelectedStyle}"
                                            PrimaryBrush="{StaticResource MiniSpectrumPrimary}"
                                            SecondaryBrush="{DynamicResource C_FFA783FF}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
