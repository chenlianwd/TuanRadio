<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:models="using:AIRadio.Desktop.Models"
             xmlns:services="using:AIRadio.Desktop.Services"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.PlaylistDrawer"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:TabVisibleConverter x:Key="TabVisibleConverter"/>
    </UserControl.Resources>

    <!-- 在播行高亮：基座外观下沉为样式 Setter（元素直写属性是 LocalValue 优先级，
    恒压过样式 Setter）；在播态=AccentGreen 描边+标题着色、不加背景 tint——
    Light 档 C_FF56F5C4(178A65) 叠 30% tint 底仅 2.87:1 不达 4.5:1 正文线，
    AccentGreen 语义 token（Dark=#56F5C4 视觉不变、Light=#0F6B57 无 tint 底 6.28:1）
    且随配色主题联动重映射 -->
    <UserControl.Styles>
        <Style Selector="Border.library-row">
            <Setter Property="Background" Value="{DynamicResource C_CC202126}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_253D3D4A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.library-row TextBlock.track-title">
            <Setter Property="Foreground" Value="{DynamicResource C_FFFFFFFF}"/>
        </Style>
        <Style Selector="Border.library-row.playing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Border.library-row.playing TextBlock.track-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.sub-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_253D3D4A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FF9B9BA8}"/>
        </Style>
        <Style Selector="Button.sub-tab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource C_FFFFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_667B7898}"/>
        </Style>
        <Style Selector="Button.sub-tab.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="FontWeight" Value="700"/>
        </Style>
        <Style Selector="Button.drawer-tab Path">
            <Setter Property="Stroke" Value="{DynamicResource C_FFEDEDF5}"/>
        </Style>
        <Style Selector="Button.drawer-tab.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.drawer-tab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.drawer-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.drawer-tab.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Button.drawer-tab.active Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="TextBlock.probe-status">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="TextBlock.probe-status.warning">
            <Setter Property="Foreground" Value="{DynamicResource StateSearchingColor}"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="DrawerRoot"
            IsVisible="{Binding IsLibraryOpen}"
            KeyboardNavigation.TabNavigation="Cycle"
            Width="455" HorizontalAlignment="Right" Margin="0,72,18,34"
            Background="{DynamicResource C_FC0E0E15}" BorderBrush="{DynamicResource C_667B7898}" BorderThickness="1"
            CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource S_Library}" FontSize="18" FontWeight="700"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FFFFFFFF}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                        Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="{DynamicResource S_CloseLibrary}"
                        AutomationProperties.Name="{DynamicResource S_CloseLibrary}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="drawer-tab"
                            Classes.active="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}"
                            Width="32" Height="28" Padding="0" Command="{Binding OpenPlaylistCommand}"
                            ToolTip.Tip="{DynamicResource S_PlaylistTab}" AutomationProperties.Name="{DynamicResource S_PlaylistTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2" Data="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L3.01,6 M3,12 L3.01,12 M3,18 L3.01,18"/>
                    </Button>
                    <Button Classes="drawer-tab"
                            Classes.active="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}"
                            Width="32" Height="28" Padding="0" Command="{Binding OpenFavoritesCommand}"
                            ToolTip.Tip="{DynamicResource S_FavoritesTab}" AutomationProperties.Name="{DynamicResource S_FavoritesTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2" Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                    </Button>
                    <Button Classes="drawer-tab"
                            Classes.active="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=3}"
                            Width="32" Height="28" Padding="0" Command="{Binding OpenProgramCommand}"
                            ToolTip.Tip="{DynamicResource S_ProgramTab}" AutomationProperties.Name="{DynamicResource S_ProgramTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L14,18"/>
                    </Button>
                    <Button Classes="drawer-tab"
                            Classes.active="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=5}"
                            Width="32" Height="28" Padding="0" Command="{Binding OpenRadioStationsCommand}"
                            ToolTip.Tip="{DynamicResource S_RadioStationsTab}" AutomationProperties.Name="{DynamicResource S_RadioStationsTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2"
                              Data="M12,12 A2,2 0 1,0 12,16 A2,2 0 1,0 12,12 M12,16 L12,22 M8.5,9.5 A5,5 0 0,0 8.5,18.5 M15.5,9.5 A5,5 0 0,1 15.5,18.5 M5.5,6.5 A9,9 0 0,0 5.5,21.5 M18.5,6.5 A9,9 0 0,1 18.5,21.5"/>
                    </Button>
                    <Button Classes="drawer-tab"
                            Classes.active="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=4}"
                            Width="32" Height="28" Padding="0" Command="{Binding OpenKugouPlaylistsCommand}"
                            IsVisible="{Binding HasExperimentalProviders}"
                            ToolTip.Tip="{DynamicResource S_KugouPlaylistsTab}" AutomationProperties.Name="{DynamicResource S_KugouPlaylistsTab}"
                            FontFamily="Consolas" FontSize="10" FontWeight="700" Content="KG"/>
                    <Button Width="32" Height="28" Padding="0" Click="OnImportFiles"
                            ToolTip.Tip="{DynamicResource S_Import}" AutomationProperties.Name="{DynamicResource S_Import}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Click="OnImportFolder"
                            IsEnabled="{Binding PlaylistVM.IsLocalLibraryScanning, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip.Tip="{DynamicResource S_ImportFolder}" AutomationProperties.Name="{DynamicResource S_ImportFolder}"
                            Content="+📁"/>
                    <Button Width="32" Height="28" Padding="0" Click="OnRescanLocalLibrary"
                            IsEnabled="{Binding PlaylistVM.IsLocalLibraryScanning, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip.Tip="{DynamicResource S_RescanLocalLibrary}" AutomationProperties.Name="{DynamicResource S_RescanLocalLibrary}"
                            Content="↻"/>
                </StackPanel>
                <!-- tab0 过滤/定位在播/清空（清空走 5 秒二次确认，文案由 VM 武装态提供） -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                    <TextBox Text="{Binding PlaylistVM.LibraryFilterText, Mode=TwoWay}"
                             Watermark="{DynamicResource S_FilterPlaylist}"/>
                    <Button Grid.Column="1" Width="32" Height="28" Padding="0" Click="OnLocatePlaying"
                            ToolTip.Tip="{DynamicResource S_LocatePlaying}" AutomationProperties.Name="{DynamicResource S_LocatePlaying}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2"
                              Data="M12,5 C15.9,5 19,8.1 19,12 C19,15.9 15.9,19 12,19 C8.1,19 5,15.9 5,12 C5,8.1 8.1,5 12,5 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12"/>
                    </Button>
                    <Button Grid.Column="2" Height="28" Padding="10,0" FontSize="11"
                            Command="{Binding PlaylistVM.ClearPlaylistCommand}"
                            Content="{Binding PlaylistVM.ClearPlaylistButtonText}"
                            ToolTip.Tip="{DynamicResource S_ClearPlaylist}" AutomationProperties.Name="{DynamicResource S_ClearPlaylist}"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                    <ComboBox ItemsSource="{Binding PlaylistVM.SyncedPlaylists}"
                              SelectedItem="{Binding PlaylistVM.SelectedSyncedPlaylist, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource S_LocalSyncedPlaylists}"
                              AutomationProperties.Name="{DynamicResource S_LocalSyncedPlaylists}"
                              IsVisible="{Binding PlaylistVM.HasSyncedPlaylists}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:SyncedPlaylistInfo">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TrackCount}" Opacity="0.65"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="{DynamicResource S_ShowAllTracks}"
                            IsVisible="{Binding PlaylistVM.HasSyncedPlaylists}"
                            Command="{Binding PlaylistVM.ShowAllLibraryTracksCommand}"/>
                </Grid>
                <TextBox Grid.Row="2" Text="{Binding PlaylistVM.KugouFilterText, Mode=TwoWay}"
                         Watermark="{DynamicResource S_SearchKugouPlaylist}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=4}"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=4}">
                    <ComboBox ItemsSource="{Binding PlaylistVM.KugouPlaylists}"
                              SelectedItem="{Binding PlaylistVM.SelectedKugouPlaylist, Mode=TwoWay}"
                              MinWidth="140"
                              IsEnabled="{Binding PlaylistVM.IsKugouLoading, Converter={StaticResource InverseBoolConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="services:KugouPlaylistInfo">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TrackCount}" Opacity="0.65"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Width="32" Content="▶" ToolTip.Tip="{DynamicResource S_PlayAll}"
                            AutomationProperties.Name="{DynamicResource S_PlayAll}"
                            IsEnabled="{Binding PlaylistVM.HasKugouPlaylistTracks}"
                            Command="{Binding PlaylistVM.PlayKugouPlaylistCommand}"/>
                    <Button Grid.Column="2" Width="32" Content="⤨" ToolTip.Tip="{DynamicResource S_ShufflePlay}"
                            AutomationProperties.Name="{DynamicResource S_ShufflePlay}"
                            IsEnabled="{Binding PlaylistVM.HasKugouPlaylistTracks}"
                            Command="{Binding PlaylistVM.ShuffleKugouPlaylistCommand}"/>
                    <Button Grid.Column="3" Content="{DynamicResource S_Refresh}"
                            IsEnabled="{Binding PlaylistVM.IsKugouLoading, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding PlaylistVM.RefreshKugouPlaylistsCommand}"/>
                    <Button Grid.Column="4" Content="{DynamicResource S_ImportPlaylist}"
                            IsEnabled="{Binding PlaylistVM.HasKugouPlaylistTracks}"
                            Command="{Binding PlaylistVM.ImportKugouPlaylistCommand}"/>
                </Grid>
                <!-- tab1 收藏顶栏 (二级分段 + 歌曲搜索与排序) -->
                <StackPanel Grid.Row="1" Spacing="8"
                            IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="sub-tab"
                                Classes.active="{Binding PlaylistVM.FavoriteSubTabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}"
                                Content="{Binding PlaylistVM.FavoriteSongsTabTitle}"
                                Command="{Binding PlaylistVM.SetFavoriteSubTabCommand}">
                            <Button.CommandParameter>
                                <x:Int32>0</x:Int32>
                            </Button.CommandParameter>
                        </Button>
                        <Button Classes="sub-tab"
                                Classes.active="{Binding PlaylistVM.FavoriteSubTabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}"
                                Content="{Binding PlaylistVM.FavoriteStationsTabTitle}"
                                Command="{Binding PlaylistVM.SetFavoriteSubTabCommand}">
                            <Button.CommandParameter>
                                <x:Int32>1</x:Int32>
                            </Button.CommandParameter>
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,10,0"
                          IsVisible="{Binding PlaylistVM.IsFavoriteSongsSubTab}">
                        <TextBox Text="{Binding PlaylistVM.FavoriteFilterText, Mode=TwoWay}"
                                 Height="32" Padding="10,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Watermark="{DynamicResource S_FilterFavorites}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PlaylistVM.FavoriteSortOptions}"
                                  SelectedItem="{Binding PlaylistVM.SelectedFavoriteSortOption, Mode=TwoWay}"
                                  Width="110" Height="32" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:FavoriteSortOption">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <!-- tab5 网络电台流派与搜索栏 -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,0,10,0"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=5}">
                    <ComboBox ItemsSource="{Binding PlaylistVM.RadioCategories}"
                              SelectedItem="{Binding PlaylistVM.SelectedRadioCategory, Mode=TwoWay}"
                              Width="112" Height="32" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:RadioCategoryItem">
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="1" Text="{Binding PlaylistVM.RadioSearchText, Mode=TwoWay}"
                             Height="32" Padding="10,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Watermark="{DynamicResource S_RadioSearchWatermark}" KeyDown="OnRadioSearchKeyDown"/>
                    <Button Grid.Column="2" Content="↻" Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PlaylistVM.IsRadioLoading, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding PlaylistVM.RefreshRadioStationsCommand}"
                            ToolTip.Tip="{DynamicResource S_RefreshProgram}"
                            AutomationProperties.Name="{DynamicResource S_RefreshProgram}"/>
                    <Button Grid.Column="3" Content="+" Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center" FontSize="16" FontWeight="600"
                            Command="{Binding PlaylistVM.OpenAddCustomStationCommand}"
                            ToolTip.Tip="{DynamicResource S_AddRadioStation}"
                            AutomationProperties.Name="{DynamicResource S_AddRadioStation}"/>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding PlaylistVM.KugouStatusMessage}"
                           IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=4}"
                           Foreground="{DynamicResource C_FFFFC86B}" FontFamily="Microsoft YaHei UI"
                           FontSize="11" TextWrapping="Wrap"/>
                <!-- 收藏页与主歌单共用状态行属性：下一首播/加队列等反馈在收藏页同样可见 -->
                <TextBlock Grid.Row="3" Text="{Binding PlaylistVM.LocalLibraryStatus}"
                           IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}"
                           Foreground="{DynamicResource C_FFFFC86B}" FontFamily="Microsoft YaHei UI"
                           FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="{Binding PlaylistVM.LocalLibraryStatus}"
                           IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}"
                           Foreground="{DynamicResource C_FFFFC86B}" FontFamily="Microsoft YaHei UI"
                           FontSize="11" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="LibraryList"
                         ItemsSource="{Binding PlaylistVM.VisibleLibraryTracks}"
                         SelectionMode="Multiple"
                         SelectedItems="{Binding PlaylistVM.SelectedLibraryTracks, Mode=TwoWay}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Track">
                            <Border Classes="library-row" Classes.playing="{Binding IsNowPlaying}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Button Width="30" Height="28" Padding="0" Content="▶"
                                            ToolTip.Tip="{DynamicResource S_PlayFromHere}" AutomationProperties.Name="{DynamicResource S_PlayFromHere}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFromLibraryCommand}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Classes="track-title" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PlayabilityText}" IsVisible="{Binding HasPlayability}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="10"
                                                   Foreground="{DynamicResource C_FFFFC86B}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource C_FF8E8E9C}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Width="32" Height="28" Padding="0"
                                            ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <PathIcon Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsFavorite}"
                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                        </Panel>
                                    </Button>
                                    <Button Grid.Column="4" Width="32" Height="28" Padding="0"
                                            ToolTip.Tip="{DynamicResource S_Remove}" AutomationProperties.Name="{DynamicResource S_Remove}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.RemoveTrackCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource C_FF9B9BA8}" StrokeThickness="2"
                                              Data="M18,6 L6,18 M6,6 L18,18"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- tab1 收藏内容区: 歌曲 / 电台双视图 -->
                <Grid IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}">
                    <!-- 歌曲子视图 -->
                    <Grid IsVisible="{Binding PlaylistVM.IsFavoriteSongsSubTab}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding PlaylistVM.HasVisibleFavoriteTracks, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock Text="{Binding PlaylistVM.FavoriteSongStatusMessage}" MaxWidth="320" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource C_FF9B9BA8}"/>
                        </StackPanel>
                        <ListBox x:Name="FavoritesList"
                                 ItemsSource="{Binding PlaylistVM.VisibleFavoriteTracks}"
                                 IsVisible="{Binding PlaylistVM.HasVisibleFavoriteTracks}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Track">
                                    <Border Classes="library-row" Classes.playing="{Binding IsNowPlaying}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Classes="track-title" FontSize="13" FontWeight="700"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource C_FF8E8E9C}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Width="32" Height="28" Padding="0"
                                                    ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}">
                                                <Panel>
                                                    <PathIcon Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                          Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                    <PathIcon Width="16" Height="16" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsFavorite}"
                                                          Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="3" Content="{DynamicResource S_Play}"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFavoriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 电台子视图 -->
                    <Grid IsVisible="{Binding PlaylistVM.IsFavoriteSongsSubTab, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding PlaylistVM.HasFavoriteStations, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock Text="{Binding PlaylistVM.FavoriteStationStatusMessage}" MaxWidth="320" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource C_FF9B9BA8}"/>
                        </StackPanel>
                        <ListBox x:Name="FavoriteStationsList"
                                 ItemsSource="{Binding PlaylistVM.FavoriteStations}"
                                 IsVisible="{Binding PlaylistVM.HasFavoriteStations}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Track">
                                    <Border Classes="library-row" Classes.playing="{Binding IsNowPlaying}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Classes="track-title" FontSize="13" FontWeight="700"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource C_2221ED76}" CornerRadius="3"
                                                    Padding="6,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding DisplayQuality, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding DisplayQuality}" FontSize="9" Foreground="{DynamicResource C_FFB9FFE8}"/>
                                            </Border>
                                            <Button Grid.Column="2" Width="32" Height="28" Padding="0"
                                                    ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}">
                                                <Panel>
                                                    <PathIcon Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                          Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                    <PathIcon Width="16" Height="16" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsFavorite}"
                                                          Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="3" Content="{DynamicResource S_TuneInStation}"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFavoriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                        <!-- 节目单是当前会话的下一组 DJ 候选，首次打开会主动生成。 -->
                        <Grid IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=3}"
                              RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding CurrentRadioProgram.Title}" FontSize="14" FontWeight="700"
                                               Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{DynamicResource S_ProgramDescription}" FontSize="10"
                                               Foreground="{DynamicResource C_FF9B9BA8}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource S_RefreshProgram}"
                                        IsEnabled="{Binding IsProgramLoading, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding RefreshProgramCommand}"/>
                            </Grid>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        IsVisible="{Binding HasCurrentRadioProgram, Converter={StaticResource InverseBoolConverter}}">
                                <TextBlock Text="{Binding ProgramStatusText}" MaxWidth="320" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource C_FF9B9BA8}"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentRadioProgram.Tracks}"
                                     IsVisible="{Binding HasCurrentRadioProgram}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:RecommendedTrack">
                                    <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Track.Title}" FontSize="13" FontWeight="700"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Track.DisplayArtist}" FontSize="11"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="9"
                                                           FontFamily="Consolas" Foreground="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="{DynamicResource S_Play}"
                                                        ToolTip.Tip="{DynamicResource S_PlayProgramTrack}"
                                                        AutomationProperties.Name="{DynamicResource S_PlayProgramTrack}"
                                                        IsEnabled="{Binding IsPlayable}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlayProgramTrackCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource C_FF9A9AA6}"/>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource C_2221ED76}" CornerRadius="3" Padding="6,1" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="{DynamicResource C_FFB9FFE8}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=4}">
                            <ListBox ItemsSource="{Binding PlaylistVM.FilteredKugouPlaylistTracks}"
                                     SelectedItem="{Binding PlaylistVM.SelectedKugouTrack, Mode=TwoWay}"
                                     IsVisible="{Binding PlaylistVM.HasKugouPlaylistTracks}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="services:OnlineTrack">
                                        <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                                <Button Grid.Column="0" Width="30" Height="28" Padding="0" Content="▶"
                                                        ToolTip.Tip="{DynamicResource S_PlayFromHere}"
                                                        AutomationProperties.Name="{DynamicResource S_PlayFromHere}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayKugouTrackCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayDuration}"
                                                           FontSize="10" FontFamily="Consolas"
                                                           Foreground="{DynamicResource C_FF8E8E9C}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Width="30" Height="28" Padding="0" Content="+1"
                                                        ToolTip.Tip="{DynamicResource S_PlayNext}"
                                                        AutomationProperties.Name="{DynamicResource S_PlayNext}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayKugouNextCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Width="30" Height="28" Padding="0" Content="+"
                                                        ToolTip.Tip="{DynamicResource S_AddToQueue}"
                                                        AutomationProperties.Name="{DynamicResource S_AddToQueue}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.AddKugouToQueueCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <!-- tab5 网络电台列表 -->
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=5}">
                            <!-- 内嵌添加/编辑/导入自定义电台卡片（彻底避免 Flyout 弹出文件选择器时失焦闪退） -->
                            <Border Grid.Row="0" Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource C_CC202126}"
                                    BorderBrush="{DynamicResource C_667B7898}" BorderThickness="1"
                                    IsVisible="{Binding PlaylistVM.IsCustomStationPanelOpen}">
                                <StackPanel Spacing="8">
                                    <!-- 顶部模式切换（非编辑模式显示） -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding !PlaylistVM.IsEditingCustomStation}">
                                            <Button Content="{DynamicResource S_TabManualAdd}" Classes="sub-tab"
                                                    Classes.active="{Binding !PlaylistVM.IsCustomImportMode}"
                                                    Command="{Binding PlaylistVM.SwitchToManualAddModeCommand}"/>
                                            <Button Content="{DynamicResource S_TabFileImport}" Classes="sub-tab"
                                                    Classes.active="{Binding PlaylistVM.IsCustomImportMode}"
                                                    Command="{Binding PlaylistVM.SwitchToFileImportModeCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource S_EditRadioStation}" FontSize="12" FontWeight="700"
                                                   Foreground="{DynamicResource C_FFFFFFFF}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding PlaylistVM.IsEditingCustomStation}"/>
                                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" Padding="0" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                ToolTip.Tip="{DynamicResource S_Cancel}"
                                                AutomationProperties.Name="{DynamicResource S_Cancel}"
                                                Command="{Binding PlaylistVM.CloseCustomStationPanelCommand}"/>
                                    </Grid>

                                    <!-- 手动添加/编辑视图 -->
                                    <StackPanel Spacing="6" IsVisible="{Binding !PlaylistVM.IsCustomImportMode}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox Text="{Binding PlaylistVM.CustomStationUrl, Mode=TwoWay}"
                                                     Height="30" Padding="8,0" FontSize="12" VerticalContentAlignment="Center"
                                                     Watermark="{DynamicResource S_StreamUrlPlaceholder}"
                                                     KeyDown="OnCustomUrlKeyDown"/>
                                            <Button Grid.Column="1" Content="{DynamicResource S_ProbeStream}"
                                                    Height="30" Padding="10,0" FontSize="11"
                                                    IsEnabled="{Binding !PlaylistVM.IsProbingStream}"
                                                    Command="{Binding PlaylistVM.ProbeCustomStreamCommand}"/>
                                        </Grid>

                                        <TextBlock Text="{Binding PlaylistVM.ProbeStatusText}" FontSize="11" TextWrapping="Wrap"
                                                   Classes="probe-status"
                                                   Classes.warning="{Binding PlaylistVM.ProbeIsWarning}"
                                                   IsVisible="{Binding PlaylistVM.ProbeStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        <TextBox Text="{Binding PlaylistVM.CustomStationName, Mode=TwoWay}"
                                                 Height="30" Padding="8,0" FontSize="12" VerticalContentAlignment="Center"
                                                 Watermark="{DynamicResource S_StationNamePlaceholder}"/>

                                        <Grid ColumnDefinitions="*,80,70" ColumnSpacing="6">
                                            <TextBox Text="{Binding PlaylistVM.CustomStationTags, Mode=TwoWay}"
                                                     Height="30" Padding="8,0" FontSize="12" VerticalContentAlignment="Center"
                                                     Watermark="{DynamicResource S_StationTagsPlaceholder}"/>
                                            <TextBox Grid.Column="1" Text="{Binding PlaylistVM.CustomStationCodec, Mode=TwoWay}"
                                                     Height="30" Padding="8,0" FontSize="11" VerticalContentAlignment="Center"
                                                     Watermark="MP3"/>
                                            <TextBox Grid.Column="2" Text="{Binding PlaylistVM.CustomStationBitrateText, Mode=TwoWay}"
                                                     Height="30" Padding="8,0" FontSize="11" VerticalContentAlignment="Center"
                                                     Watermark="kbps"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="{DynamicResource S_Cancel}" Padding="10,5" FontSize="11"
                                                    Command="{Binding PlaylistVM.CloseCustomStationPanelCommand}"/>
                                            <Button Content="{DynamicResource S_SaveOnly}" Padding="10,5" FontSize="11"
                                                    Command="{Binding PlaylistVM.SaveCustomStationOnlyCommand}"/>
                                            <Button Content="{DynamicResource S_SaveAndPlay}" Padding="12,5" FontSize="11" FontWeight="600"
                                                    Background="{DynamicResource C_2221ED76}"
                                                    BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1"
                                                    Foreground="{DynamicResource AccentGreen}"
                                                    Command="{Binding PlaylistVM.SaveAndPlayCustomStationCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 从文件导入视图 -->
                                    <StackPanel Spacing="8" IsVisible="{Binding PlaylistVM.IsCustomImportMode}">
                                        <Button Content="{DynamicResource S_ChoosePlaylistFile}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="12,10" FontSize="12"
                                                Click="OnChoosePlaylistFileClick"/>

                                        <TextBlock Text="{Binding PlaylistVM.ImportSummaryText}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource C_FF9B9BA8}"
                                                   IsVisible="{Binding PlaylistVM.ImportSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        <ListBox ItemsSource="{Binding PlaylistVM.ImportPreviewStations}"
                                                 MaxHeight="130"
                                                 IsVisible="{Binding PlaylistVM.HasImportPreview}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="models:RadioStation">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="2">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Codec}" FontSize="10" Foreground="{DynamicResource C_FF9B9BA8}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource S_Cancel}" Padding="10,5" FontSize="11"
                                                    Command="{Binding PlaylistVM.CloseCustomStationPanelCommand}"/>
                                            <Button Content="{DynamicResource S_ImportAll}" Padding="12,5" FontSize="11" FontWeight="600"
                                                    Background="{DynamicResource C_2221ED76}"
                                                    BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1"
                                                    Foreground="{DynamicResource AccentGreen}"
                                                    IsEnabled="{Binding PlaylistVM.HasImportPreview}"
                                                    Command="{Binding PlaylistVM.ConfirmImportCustomStationsCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            IsVisible="{Binding PlaylistVM.HasRadioStations, Converter={StaticResource InverseBoolConverter}}">
                                    <TextBlock Text="{Binding PlaylistVM.RadioStatusMessage}" MaxWidth="320" TextAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{DynamicResource C_FF9B9BA8}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding PlaylistVM.RadioStations}"
                                         IsVisible="{Binding PlaylistVM.HasRadioStations}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:RadioStation">
                                            <Border Classes="library-row">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource S_TuneInStation}"
                                                                  Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayRadioStationCommand}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{DynamicResource S_Favorite}"
                                                                  Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.FavoriteRadioStationCommand}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator IsVisible="{Binding IsCustom}"/>
                                                        <MenuItem Header="{DynamicResource S_EditRadioStation}"
                                                                  IsVisible="{Binding IsCustom}"
                                                                  Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.EditCustomStationCommand}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="{DynamicResource S_DeleteRadioStation}"
                                                                  IsVisible="{Binding IsCustom}"
                                                                  Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.DeleteCustomStationCommand}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Classes="track-title" FontSize="13" FontWeight="700"
                                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DisplayCountryAndTags}" FontSize="11"
                                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                                   Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource C_2221ED76}" CornerRadius="3"
                                                            Padding="6,1" VerticalAlignment="Center"
                                                            IsVisible="{Binding DisplayQuality, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding DisplayQuality}" FontSize="9" Foreground="{DynamicResource C_FFB9FFE8}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsCustom}">
                                                        <Button Content="✎" Width="26" Height="26" Padding="0" FontSize="11"
                                                                ToolTip.Tip="{DynamicResource S_EditRadioStation}"
                                                                AutomationProperties.Name="{DynamicResource S_EditRadioStation}"
                                                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.EditCustomStationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="11"
                                                                ToolTip.Tip="{DynamicResource S_DeleteRadioStation}"
                                                                AutomationProperties.Name="{DynamicResource S_DeleteRadioStation}"
                                                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.DeleteCustomStationCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Width="32" Height="28" Padding="0"
                                                            ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.FavoriteRadioStationCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Panel>
                                                            <PathIcon Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsFavorite}"
                                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="4" Content="{DynamicResource S_TuneInStation}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayRadioStationCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
</UserControl>
