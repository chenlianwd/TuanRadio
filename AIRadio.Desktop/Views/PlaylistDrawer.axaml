<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:models="using:AIRadio.Desktop.Models"
             xmlns:services="using:AIRadio.Desktop.Services"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.PlaylistDrawer"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:TabVisibleConverter x:Key="TabVisibleConverter"/>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
    </UserControl.Resources>

    <Border IsVisible="{Binding IsLibraryOpen}"
            Width="455" HorizontalAlignment="Right" Margin="0,72,18,34"
            Background="#FC0E0E15" BorderBrush="#667B7898" BorderThickness="1"
            CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="LIBRARY" FontSize="18" FontWeight="700"
                           FontFamily="Consolas" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                        Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="Close library">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenPlaylistCommand}" ToolTip.Tip="Playlist">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L3.01,6 M3,12 L3.01,12 M3,18 L3.01,18"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenFavoritesCommand}" ToolTip.Tip="Favorites">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenSearchCommand}" ToolTip.Tip="Search">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Click="OnImportFiles" ToolTip.Tip="Import">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                    <TextBox Text="{Binding PlaylistVM.SearchText, Mode=TwoWay}"
                             Watermark="Search songs..." KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1" Content="{Binding PlaylistVM.SearchButtonText}"
                            IsEnabled="{Binding PlaylistVM.IsSearching, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding PlaylistVM.SearchCommand}"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding PlaylistVM.SearchStatusMessage}"
                           IsVisible="{Binding PlaylistVM.HasSearchStatus}"
                           Foreground="#FFFFC86B" FontFamily="Microsoft YaHei UI"
                           FontSize="11" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding PlaylistVM.Tracks}"
                         SelectedItem="{Binding PlaylistVM.SelectedTrack}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Track">
                            <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="#FF8E8E9C" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2"
                                            Content="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ItemsSource="{Binding PlaylistVM.Favorites}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Track">
                            <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="PLAY"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFavoriteCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ItemsSource="{Binding PlaylistVM.SearchResults}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="services:OnlineTrack">
                            <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="PLAY"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayOnlineCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="ADD"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.AddOnlineCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
