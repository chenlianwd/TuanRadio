<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:models="using:AIRadio.Desktop.Models"
             xmlns:services="using:AIRadio.Desktop.Services"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             xmlns:local="using:AIRadio.Desktop.Views"
             x:Class="AIRadio.Desktop.Views.PlaylistDrawer"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:TabVisibleConverter x:Key="TabVisibleConverter"/>
    </UserControl.Resources>

    <Border IsVisible="{Binding IsLibraryOpen}"
            Width="455" HorizontalAlignment="Right" Margin="0,72,18,34"
            Background="{DynamicResource C_FC0E0E15}" BorderBrush="{DynamicResource C_667B7898}" BorderThickness="1"
            CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="LIBRARY" FontSize="18" FontWeight="700"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FFFFFFFF}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                        Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="{DynamicResource S_CloseLibrary}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenPlaylistCommand}" ToolTip.Tip="{DynamicResource S_PlaylistTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L3.01,6 M3,12 L3.01,12 M3,18 L3.01,18"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenFavoritesCommand}" ToolTip.Tip="{DynamicResource S_FavoritesTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                    </Button>
                    <Button Width="32" Height="28" Padding="0" Command="{Binding OpenSearchCommand}" ToolTip.Tip="{DynamicResource S_SearchTab}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                    </Button>
                            <Button Width="32" Height="28" Padding="0" Command="{Binding OpenProgramCommand}" ToolTip.Tip="{DynamicResource S_ProgramTab}">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L14,18"/>
                            </Button>
                            <Button Width="32" Height="28" Padding="0" Click="OnImportFiles" ToolTip.Tip="{DynamicResource S_Import}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                      IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                    <TextBox Text="{Binding PlaylistVM.SearchText, Mode=TwoWay}"
                             Watermark="{DynamicResource S_SearchWatermark}" KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1" Content="{Binding PlaylistVM.SearchButtonText}"
                            IsEnabled="{Binding PlaylistVM.IsSearching, Converter={StaticResource InverseBoolConverter}}"
                            Command="{Binding PlaylistVM.SearchCommand}"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding PlaylistVM.SearchStatusMessage}"
                           IsVisible="{Binding PlaylistVM.HasSearchStatus}"
                           Foreground="{DynamicResource C_FFFFC86B}" FontFamily="Microsoft YaHei UI"
                           FontSize="11" TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding PlaylistVM.Tracks}"
                         SelectedItem="{Binding PlaylistVM.SelectedTrack}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Track">
                            <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource C_FF8E8E9C}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Width="32" Height="28" Padding="0"
                                            ToolTip.Tip="{DynamicResource S_Favorite}" AutomationProperties.Name="{DynamicResource S_Favorite}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <PathIcon Width="16" Height="16" IsVisible="{Binding !IsFavorite}"
                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsFavorite}"
                                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                        </Panel>
                                    </Button>
                                    <Button Grid.Column="3" Width="32" Height="28" Padding="0"
                                            ToolTip.Tip="{DynamicResource S_Remove}" AutomationProperties.Name="{DynamicResource S_Remove}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.RemoveTrackCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{DynamicResource C_FF9B9BA8}" StrokeThickness="2"
                                              Data="M18,6 L6,18 M6,6 L18,18"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ItemsSource="{Binding PlaylistVM.Favorites}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Track">
                            <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayArtist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource S_Play}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFavoriteCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ItemsSource="{Binding PlaylistVM.SearchResults}"
                         IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="services:OnlineTrack">
                            <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource S_Play}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayOnlineCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="{DynamicResource S_Add}"
                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.AddOnlineCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 节目单是当前会话的下一组 DJ 候选，首次打开会主动生成。 -->
                        <Grid IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=3}"
                              RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding CurrentRadioProgram.Title}" FontSize="14" FontWeight="700"
                                               Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{DynamicResource S_ProgramDescription}" FontSize="10"
                                               Foreground="{DynamicResource C_FF9B9BA8}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource S_RefreshProgram}"
                                        IsEnabled="{Binding IsProgramLoading, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding RefreshProgramCommand}"/>
                            </Grid>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        IsVisible="{Binding HasCurrentRadioProgram, Converter={StaticResource InverseBoolConverter}}">
                                <TextBlock Text="{Binding ProgramStatusText}" MaxWidth="320" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource C_FF9B9BA8}"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentRadioProgram.Tracks}"
                                     IsVisible="{Binding HasCurrentRadioProgram}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:RecommendedTrack">
                                    <Border Background="{DynamicResource C_CC202126}" BorderBrush="{DynamicResource C_253D3D4A}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Track.Title}" FontSize="13" FontWeight="700"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FFFFFFFF}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Track.DisplayArtist}" FontSize="11"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource C_FF9B9BA8}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="9"
                                                           FontFamily="Consolas" Foreground="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="{DynamicResource S_Play}"
                                                        ToolTip.Tip="{DynamicResource S_PlayProgramTrack}"
                                                        IsEnabled="{Binding IsPlayable}"
                                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlayProgramTrackCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource C_FF9A9AA6}"/>
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource C_2221ED76}" CornerRadius="3" Padding="6,1" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="{DynamicResource C_FFB9FFE8}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
</UserControl>
