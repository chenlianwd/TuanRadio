<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.PlayerDeck"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <!-- 进度条同位显影：静止态收敛为发丝线——滑条整体降不透明度 0.8（经 4 主题×2 变体
         与 deck 底色合成对比度预检，图形 3:1 门槛最低 3.41 Amber/Light——Light 档 deck
         不透明直算、Dark 档按 0xE9 合成到窗口底；0.75 已贴 3.36，调低前须复算）、
         拇指与两侧时间文本隐去；悬停播放区或滑条获焦时 150ms 淡入完整形态。纯样式层
         变换、布局零位移，轨道在静止态照常可点按拖动（Opacity 不影响命中）。
         音量滑条同款语汇：静止态发丝线+拇指隐，悬停右上音量区（VolumeArea）或获焦
         显影；音量数值由旁边百分比文本常显兜底。
         拇指为竖条调谐针（2026-10-29 用户反馈 Fluent 默认实心圆点突兀）：Fluent 默认
         拇指是 20×20 控件整体当圆（SliderThumbCornerRadius=10 实心 Border），命中区
         即控件尺寸、由 Slider 模板的 SliderHorizontalThumbWidth/Height 决定——整替
         Template 时根必须保持铺满（透明底）才不缩命中区；竖条 4×14 与左上三连竖条
         徽标同构，AccentGreen 与填充同 token（Light 档同 0F6B57，无双色错配）。 -->
    <UserControl.Styles>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border Width="4" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentGreen}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider#ProgressSlider">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider#ProgressSlider /template/ Thumb">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.progressTimeText">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 显影态声明在静止态之后（同优先级后声明者胜出） -->
        <Style Selector="Border#DeckRoot:pointerover Slider#ProgressSlider">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border#DeckRoot:pointerover Slider#ProgressSlider /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border#DeckRoot:pointerover TextBlock.progressTimeText">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 键盘焦点同样显影滑条与拇指（时间文本为滑条兄弟节点，:focus 不上溯，不跟焦显示） -->
        <Style Selector="Slider#ProgressSlider:focus">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Slider#ProgressSlider:focus /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 音量滑条静止态：同款发丝线收敛（显影态声明在静止态之后，同优先级后声明者胜出） -->
        <Style Selector="Slider#VolumeSlider">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider#VolumeSlider /template/ Thumb">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 悬停右上音量区才显影（局部化触发，不随整 deck 点亮）；拖动中指针捕获丢
             :pointerover，靠滑条获焦兜底显影（同进度条机制） -->
        <Style Selector="StackPanel#VolumeArea:pointerover Slider#VolumeSlider">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="StackPanel#VolumeArea:pointerover Slider#VolumeSlider /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Slider#VolumeSlider:focus">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Slider#VolumeSlider:focus /template/ Thumb">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border x:Name="DeckRoot" Background="{DynamicResource C_E91B1B2A}" BorderBrush="{DynamicResource C_223D3D4F}" BorderThickness="0,1" Padding="22,8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="165,*,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Border Width="3" Height="11" Background="{DynamicResource C_FF56F5C4}" CornerRadius="2"/>
                    <Border Width="3" Height="17" Background="{DynamicResource C_FF56F5C4}" CornerRadius="2"/>
                    <Border Width="3" Height="9" Background="{DynamicResource C_FF56F5C4}" CornerRadius="2"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding PlayerVM.TrackTitle}" FontSize="14" FontWeight="700"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"
                               TextTrimming="CharacterEllipsis" MaxWidth="128"
                               ToolTip.Tip="{Binding PlayerVM.TrackTitle}"/>
                    <TextBlock Text="{Binding PlayerVM.TrackArtist}" FontSize="11"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FF9A9AA8}"
                               TextTrimming="CharacterEllipsis" MaxWidth="128"
                               ToolTip.Tip="{Binding PlayerVM.TrackArtist}"/>
                    <!-- 音源 · 音质品级（试听片段）：编码/码率细节悬停 Tooltip 可见，无数据时整段隐藏 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" MaxWidth="128">
                        <TextBlock Text="{Binding PlayerVM.TrackSource}" FontSize="10"
                                   Foreground="{DynamicResource C_FF9A9AA8}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource C_FF9A9AA8}"
                                   IsVisible="{Binding PlayerVM.HasQuality}"/>
                        <TextBlock Text="{Binding PlayerVM.TrackQualityText}" FontSize="10"
                                   Foreground="{DynamicResource C_FF9A9AA8}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding PlayerVM.HasQuality}"
                                   ToolTip.Tip="{Binding PlayerVM.TrackQualityDetail}"/>
                        <Border IsVisible="{Binding PlayerVM.TrackIsPreview}" BorderBrush="{DynamicResource C_FF9A9AA8}"
                                BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerVM.TrackPreviewText}" FontSize="9"
                                       Foreground="{DynamicResource C_FF9A9AA8}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Width="34" Height="34" Command="{Binding PlayerVM.PreviousCommand}"
                        ToolTip.Tip="{DynamicResource S_Prev}" AutomationProperties.Name="{DynamicResource S_Prev}">
                    <PathIcon Width="16" Height="16" Data="M6,5 L6,19 M18,6 L9,12 L18,18 Z"/>
                </Button>
                <Button Width="38" Height="38" Background="{DynamicResource C_302B2E3C}" Command="{Binding PlayerVM.PlayCommand}"
                        ToolTip.Tip="{DynamicResource S_PlayPause}" AutomationProperties.Name="{DynamicResource S_PlayPause}">
                    <Grid>
                        <PathIcon Width="15" Height="15" IsVisible="{Binding PlayerVM.IsPlaying, Converter={StaticResource InverseBoolConverter}}"
                                  Data="M8,5 L19,12 L8,19 Z"/>
                        <PathIcon Width="15" Height="15" IsVisible="{Binding PlayerVM.IsPlaying}"
                                  Data="M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z"/>
                    </Grid>
                </Button>
                <Button Width="34" Height="34" Command="{Binding PlayerVM.NextCommand}"
                        ToolTip.Tip="{DynamicResource S_Next}" AutomationProperties.Name="{DynamicResource S_Next}">
                    <PathIcon Width="16" Height="16" Data="M18,5 L18,19 M6,6 L15,12 L6,18 Z"/>
                </Button>
                <Button Width="62" Height="34" Command="{Binding PlayerVM.ToggleRepeatCommand}"
                        ToolTip.Tip="{Binding PlayerVM.RepeatModeTip}" AutomationProperties.Name="{Binding PlayerVM.RepeatModeTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M17,1 L21,5 L17,9 M3,11 L3,9 C3,6.8 4.8,5 7,5 L21,5 M7,23 L3,19 L7,15 M21,13 L21,15 C21,17.2 19.2,19 17,19 L3,19"/>
                        <TextBlock Text="{Binding PlayerVM.RepeatText}" FontSize="9"/>
                    </StackPanel>
                </Button>
                <Button Width="34" Height="34" Command="{Binding ToggleCurrentFavoriteCommand}"
                        ToolTip.Tip="{DynamicResource S_FavCurrent}" AutomationProperties.Name="{DynamicResource S_FavCurrent}">
                    <Grid>
                        <PathIcon Width="17" Height="17" IsVisible="{Binding IsCurrentFavorite, Converter={StaticResource InverseBoolConverter}}"
                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                        <PathIcon Width="17" Height="17" Foreground="{DynamicResource C_FF56F5C4}" IsVisible="{Binding IsCurrentFavorite}"
                                  Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" MinWidth="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LibraryButton" Width="32" Height="30" Padding="0" Command="{Binding ToggleLibraryCommand}"
                        ToolTip.Tip="{DynamicResource S_Library}" AutomationProperties.Name="{DynamicResource S_Library}">
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"/>
                </Button>
                <!-- 音量区（VolumeArea）只含 VOL/滑条/百分比——资料库按钮在显影触发簇外
                     （悬停开资料库不该点亮音量条）；透明底让文本与间隙也可命中（悬停划过
                     不回落闪烁，同频谱命中层手法） -->
                <StackPanel x:Name="VolumeArea" Orientation="Horizontal" Spacing="6" Background="Transparent">
                    <TextBlock Text="VOL" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource C_FF8A8A96}" VerticalAlignment="Center"/>
                    <!-- Foreground 与进度条同用 AccentGreen：填充与拇指/百分比同 token，
                         Light 档不再与 Fluent Accent(178A65) 双绿错配（左上徽标是
                         C_FF56F5C4，薄荷绿 Light 档与 AccentGreen 微差、调色板下同值） -->
                    <Slider x:Name="VolumeSlider" Width="90" MinWidth="0" Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"
                            Foreground="{DynamicResource AccentGreen}"
                            PointerReleased="OnVolumeSliderReleased"/>
                    <TextBlock x:Name="VolumePercentText" Width="34" Text="{Binding PlayerVM.Volume, StringFormat={}{0:P0}}"
                               FontSize="10" FontFamily="Consolas" TextAlignment="Right"
                               Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Width="42" Height="24" Padding="0" Content="NOPE"
                        FontSize="9" Command="{Binding DislikeCurrentTrackCommand}"
                        ToolTip.Tip="{DynamicResource S_Dislike}" AutomationProperties.Name="{DynamicResource S_Dislike}"/>
                <Button Width="42" Height="24" Padding="0" Content="SIM"
                        FontSize="9" Command="{Binding SimilarToCurrentTrackCommand}"
                        ToolTip.Tip="{DynamicResource S_Similar}" AutomationProperties.Name="{DynamicResource S_Similar}"/>
                <Button Width="42" Height="24" Padding="0" Content="CALM"
                        FontSize="9" Command="{Binding CalmerRecommendationCommand}"
                        ToolTip.Tip="{DynamicResource S_Calmer}" AutomationProperties.Name="{DynamicResource S_Calmer}"/>
                <Button Width="42" Height="24" Padding="0" Content="FIRE"
                        FontSize="9" Command="{Binding EnergeticRecommendationCommand}"
                        ToolTip.Tip="{DynamicResource S_Energetic}" AutomationProperties.Name="{DynamicResource S_Energetic}"/>
                <Button Width="48" Height="24" Padding="0" Content="STORY"
                        FontSize="9" Command="{Binding TellSongStoryCommand}"
                        ToolTip.Tip="{DynamicResource S_SongStory}" AutomationProperties.Name="{DynamicResource S_SongStory}"/>
            </StackPanel>

            <!-- Fluent Slider 模板是 15/thumb20/15 像素行（自然高 50；行 0 即被音量滑条
                 以此撑到 50）。进度行若只靠 Height 压制，模板像素行不缩放、拇指顶锚下坠
                 9px 贴底；行内覆写清零预留边距使模板自然高收敛到拇指 20px，与时间文本对齐。
                 作用域在本 Grid 子树，行 0 音量滑条不受影响 -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="42,*,42" Height="20" Margin="0,4,0,0">
                <Grid.Resources>
                    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
                    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
                    <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                </Grid.Resources>
                <TextBlock Grid.Column="0" Classes="progressTimeText" Text="{Binding PlayerVM.PositionText}" FontSize="11"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FF9A9AA6}" VerticalAlignment="Center"/>
                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="{Binding PlayerVM.TotalSeconds}"
                        Foreground="{DynamicResource AccentGreen}"
                        Value="{Binding PlayerVM.CurrentSeconds}"/>
                <TextBlock Grid.Column="2" Classes="progressTimeText" Text="{Binding PlayerVM.DurationText}" FontSize="11"
                           FontFamily="Consolas" Foreground="{DynamicResource C_FF9A9AA6}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
