<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIRadio.Desktop.ViewModels"
        xmlns:views="using:AIRadio.Desktop.Views"
        xmlns:models="using:AIRadio.Desktop.Models"
        x:Class="AIRadio.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AIRadio"
        Width="800" Height="560"
        MinWidth="700" MinHeight="480"
        Background="#FF0A0A0A">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#FF1C1C1C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2A2A2A"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FF1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2A2A2A"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF1E1E1E"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Width" Value="4"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#FF0A0A0A" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#FF9B59B0"/>
                    <TextBlock Text="Tune" FontSize="14" FontWeight="700" Foreground="#FFFFFFFF"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="▶" FontSize="11" Padding="8,6" Background="Transparent"/>
                    <TextBlock Text="Radio" FontSize="13" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#FF3A1515" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="LIVE" FontSize="10" FontWeight="700" Foreground="#FFFF4444"/>
                    </Border>
                    <Button Content="▢" FontSize="14" Padding="8,6" Background="Transparent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom player bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF141414" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Progress slider -->
                <Grid Grid.Row="0" ColumnDefinitions="40,*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{Binding PlayerVM.PositionText}" FontSize="10" Foreground="#FF666666"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding PlayerVM.TotalSeconds}"
                            Value="{Binding PlayerVM.CurrentSeconds}"
                            Margin="8,0" VerticalAlignment="Center"
                            PointerReleased="OnProgressSliderReleased"/>
                    <TextBlock Grid.Column="2" Text="{Binding PlayerVM.DurationText}" FontSize="10" Foreground="#FF666666"
                               VerticalAlignment="Center" MinWidth="36"/>
                </Grid>

                <!-- Controls row -->
                <Grid Grid.Row="1" ColumnDefinitions="40,*,Auto,Auto,Auto,50">
                    <!-- Album art -->
                    <Border Grid.Column="0" Background="#FF0D0D0D" CornerRadius="4" Width="32" Height="32">
                        <TextBlock Text="♪" FontSize="14" Foreground="#FF333333"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Track info -->
                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerVM.TrackTitle}" FontSize="11" FontWeight="600"
                                   Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PlayerVM.TrackArtist}" FontSize="9" Foreground="#FF666666"/>
                    </StackPanel>

                    <!-- Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Content="◁" FontSize="12" Padding="8,6" Background="Transparent"
                                Command="{Binding PlayerVM.PreviousCommand}"/>
                        <Button Content="{Binding PlayerVM.PlayPauseText}" FontSize="12" Padding="8,6"
                                Background="#FF9B59B0" Foreground="#FFFFFFFF" CornerRadius="100"
                                Command="{Binding PlayerVM.PlayCommand}"/>
                        <Button Content="▷▷" FontSize="12" Padding="8,6" Background="Transparent"
                                Command="{Binding PlayerVM.NextCommand}"/>
                    </StackPanel>

                    <!-- Volume slider -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="🔊" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"
                                Width="60" VerticalAlignment="Center"
                                PointerReleased="OnVolumeSliderReleased"/>
                    </StackPanel>

                    <!-- LIVE -->
                    <Border Grid.Column="4" Background="#FF3A1515" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="LIVE" FontSize="9" FontWeight="700" Foreground="#FFFF4444"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>240,*</Grid.ColumnDefinitions>

            <!-- LEFT: Character + Chat -->
            <Grid Grid.Column="0" Margin="10,0">
                <Grid.RowDefinitions>Auto,*,Auto</Grid.RowDefinitions>

                <!-- Character avatar -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Border Width="140" Height="140" CornerRadius="70" Background="#FF1A1A1A" BorderBrush="#FF9B59B0" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCharacter.DisplayName[0]}" FontSize="48" FontWeight="700"
                                       Foreground="#FF9B59B0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedCharacter.DisplayName}" FontSize="15" FontWeight="600"
                               Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="AI陪你听歌" FontSize="11"
                               Foreground="#FF666666" HorizontalAlignment="Center"/>

                    <!-- Character pills -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CharacterProfile">
                                    <Border Background="#FF1C1C1C" CornerRadius="12" Padding="8,4" Cursor="Hand"
                                            PointerPressed="OnCharacterSelected">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="#FF9B59B0">
                                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="8" FontWeight="700"
                                                           Foreground="#FF0A0A0A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Chat bubbles -->
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding SenderName}" FontSize="9" Foreground="#FF9B59B0" Margin="6,0,0,1"/>
                                    <Border Background="#FF1C1C1C" CornerRadius="10" Padding="8,6" MaxWidth="220" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="#FFFFFFFF" LineHeight="16"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="8"
                                                       Foreground="#FF555555" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Chat input -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBox Grid.Column="0" Text="{Binding ChatVM.InputText, Mode=TwoWay}"
                             Watermark="输入消息..." KeyDown="OnChatInputKeyDown"/>
                    <Button Grid.Column="1" Content="发送" Padding="14,8" Background="#FF9B59B0" Foreground="#FF0A0A0A"
                            Margin="6,0,0,0" Command="{Binding ChatVM.SendMessageCommand}"/>
                </Grid>
            </Grid>

            <!-- RIGHT: Playlist -->
            <Border Grid.Column="1" Background="#FF141414" Margin="0,10,10,10" Padding="10">
                <views:PlaylistView DataContext="{Binding PlaylistVM}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
