<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIRadio.Desktop.ViewModels"
        xmlns:views="using:AIRadio.Desktop.Views"
        xmlns:models="using:AIRadio.Desktop.Models"
        x:Class="AIRadio.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AIRadio"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="550"
        Background="#FF000000">

    <Window.Styles>
        <!-- Basic button style -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#FF1C1C1C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2A2A2A"/>
        </Style>

        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FF1C1C1C"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#border">
            <Setter Property="BorderBrush" Value="#FF333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ListBox -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2A2A2A"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF222222"/>
        </Style>

        <!-- ScrollBar -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- Slider -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#FF1ED760"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*">
        <!-- Top bar - minimal black bar -->
        <Border Grid.Row="0" Background="#FF0A0A0A">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#FF1ED760"/>
                    <TextBlock Text="AIRadio" FontSize="14" FontWeight="700" Foreground="#FFFFFFFF"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ToggleSettingsCommand}"
                        Content="设置" FontSize="12" Padding="12,6" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- Main content - left playlist, right chat -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>360,*</Grid.ColumnDefinitions>

            <!-- Left: Playlist & Player -->
            <ScrollViewer Grid.Column="0" Background="#FF000000">
                <StackPanel Margin="12">
                    <!-- Character selector -->
                    <TextBlock Text="选择主播" FontSize="11" Foreground="#FF666666" Margin="4,0,0,8"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CharacterProfile">
                                    <Border Background="#FF1C1C1C" CornerRadius="20" Padding="10,6"
                                            Cursor="Hand" PointerPressed="OnCharacterSelected">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#FF1ED760">
                                                <TextBlock Text="{Binding DisplayName[0]}" FontSize="11" FontWeight="700"
                                                           Foreground="#FF000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#FFFFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Player card -->
                    <Border Background="#FF1C1C1C" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel Spacing="12">
                            <!-- Album art placeholder -->
                            <Border Height="160" CornerRadius="8" Background="#FF0D0D0D">
                                <Grid>
                                    <TextBlock Text="♪" FontSize="48" Foreground="#FF333333"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Play button overlay -->
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Width="48" Height="48" CornerRadius="24" Background="#FF1ED760">
                                        <TextBlock Text="▶" FontSize="20" Foreground="#FF000000"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Track info -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding PlayerVM.TrackTitle}" FontSize="15" FontWeight="700"
                                           Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PlayerVM.TrackArtist}" FontSize="12"
                                           Foreground="#FF666666"/>
                            </StackPanel>

                            <!-- Progress -->
                            <StackPanel Spacing="4">
                                <Slider Minimum="0" Maximum="{Binding PlayerVM.TotalSeconds}"
                                        Value="{Binding PlayerVM.CurrentSeconds}"
                                        PointerReleased="OnSliderReleased"
                                        Classes="player-slider"/>
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding PlayerVM.PositionText}"
                                               FontSize="10" Foreground="#FF666666"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayerVM.DurationText}"
                                               FontSize="10" Foreground="#FF666666" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Controls -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="🔀" FontSize="14" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <Button Content="⏮" FontSize="16" Padding="10" Background="Transparent"
                                            Command="{Binding PlayerVM.PreviousCommand}"/>
                                    <Button Content="{Binding PlayerVM.PlayPauseText}" FontSize="20" Padding="14"
                                            CornerRadius="100" Background="#FF1ED760" Foreground="#FF000000"
                                            Command="{Binding PlayerVM.PlayCommand}"/>
                                    <Button Content="⏭" FontSize="16" Padding="10" Background="Transparent"
                                            Command="{Binding PlayerVM.NextCommand}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="🔁" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Volume -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="🔊" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Playlist -->
                    <TextBlock Text="播放列表" FontSize="11" Foreground="#FF666666" Margin="4,0,0,8"/>
                    <Border Background="#FF1C1C1C" CornerRadius="12" Padding="8">
                        <views:PlaylistView DataContext="{Binding PlaylistVM}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Chat -->
            <views:ChatView Grid.Column="1" DataContext="{Binding ChatVM}" Margin="0,12,12,12"/>
        </Grid>
    </Grid>
</Window>