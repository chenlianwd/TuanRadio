<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIRadio.Desktop.ViewModels"
        xmlns:models="using:AIRadio.Desktop.Models"
        xmlns:services="using:AIRadio.Desktop.Services"
        xmlns:local="using:AIRadio.Desktop.Views"
        xmlns:conv="using:AIRadio.Desktop.Converters"
        x:Class="AIRadio.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TuanRadio FM"
        Icon="/Assets/airadio.ico"
        Width="760" Height="760"
        MinWidth="700" MinHeight="700"
        SystemDecorations="None"
        Background="{DynamicResource WindowBg}"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <conv:TabVisibleConverter x:Key="TabVisibleConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource C_11121620}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FFEDEDF5}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_333A3D4A}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <!-- Fluent 模板内容对齐默认 Stretch：文字 TextBlock 被 arrange 到整个内容区、
                 字形从左上起排（ContentPresenter.ArrangeOverrideImpl 的 Stretch 分支不收缩
                 尺寸也不加偏移）→ 纯文本按钮（反馈行 NOPE 等）字形贴上沿偏约 4px 且偏左；
                 图标按钮因 PathIcon 固定尺寸拉不动而幸免。显式 Center 双向居中 -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_24212632}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource C_FF07070B}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FFFFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_889090A0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="14"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- DJ 说话中（TTS 正在出声，ChatVM.IsSpeaking）：徽章描强调绿圈、主播名点亮；
             圈的辉光另由 code-behind 随 TTS 播放链真实音量驱动（MainWindow.RunGlowAsync） -->
        <Style Selector="Border#AvatarBorder.speaking">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="TextBlock#HostNameText.speaking">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>

        <!-- 睡眠定时按钮激活态：月牙图标点亮 AccentGreen 并发光 -->
        <Style Selector="Button#SleepTimerButton Path">
            <Setter Property="Fill" Value="{DynamicResource C_FFEDEDF5}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button#SleepTimerButton.active Path">
            <Setter Property="Fill" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <!-- 睡眠定时 Flyout 浮层样式 -->
        <Style Selector="FlyoutPresenter.sleep-timer-flyout">
            <Setter Property="Background" Value="{DynamicResource C_FC0E0E15}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_667B7898}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinWidth" Value="196"/>
        </Style>

        <!-- 睡眠定时选项按钮样式 -->
        <Style Selector="Button.timer-opt">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FFEDEDF5}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.timer-opt:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_24212632}"/>
        </Style>
        <Style Selector="Button.timer-opt.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="FontWeight" Value="600"/>
        </Style>
        <Style Selector="Button.timer-opt.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_10000000}"/>
        </Style>
        <Style Selector="Button.timer-opt:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" Background="{DynamicResource SurfaceRoot}" RowDefinitions="30,*">
        <local:TitleBar Grid.Row="0" IsVisible="{Binding !IsCompactMode}"/>

        <Border x:Name="ShellCard" Grid.Row="1"
                IsVisible="{Binding !IsCompactMode}"
                Margin="14"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource SurfaceShell}"
                BorderBrush="{DynamicResource BorderShell}"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="True">
            <Grid>
            <Grid RowDefinitions="64,168,124,*,66,28">
                <!-- Brand header -->
                <Border x:Name="BrandHeader" Grid.Row="0" Background="{DynamicResource SurfaceHeader}" Padding="22,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- 点徽章即切换主播（2026-11-03 用户裁决：省去右侧独立按钮，
                             「要切换谁就点谁」语义直觉）；hover 由 Window 按钮 pointerover 样式提供 -->
                        <Button x:Name="AvatarButton" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="6,3" CornerRadius="8"
                                Command="{Binding ToggleCharacterPickerCommand}"
                                ToolTip.Tip="{DynamicResource S_HostPicker}" AutomationProperties.Name="{DynamicResource S_HostPicker}">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <!-- 黑胶唱片头像（网易云播放页黑胶的 34px 简化）：外缘高光 + 三圈沟纹 +
                                     中心专属色标签 + 对置反光点；外层 Border 承担说话辉光/描圈/弹跳
                                     （RenderTransform 被 TranslateTransform 占用），内层 AvatarDisc 挂旋转。
                                     注意：Avalonia Visual.RenderTransformOrigin 默认即 RelativePoint.Center（50%,50% = 盘心 17,17），
                                     而 RotateTransform.CenterX/Y 是相对原点的额外偏移，必须保持 0,0（默认）才原地自转 -->
                                <Border x:Name="AvatarBorder" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource C_FF262632}"
                                        Classes.speaking="{Binding ChatVM.IsSpeaking}">
                                    <Grid x:Name="AvatarDisc" Width="34" Height="34">
                                        <Grid.RenderTransform>
                                            <RotateTransform/>
                                        </Grid.RenderTransform>
                                        <!-- 外缘高光（黑胶边缘反光） -->
                                        <Ellipse Width="33" Height="33" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="1"
                                                 Fill="Transparent" Opacity="0.22"/>
                                        <!-- 沟纹带：三圈同心细环（径向纹路在 34px 的简化；明暗交替更接近实物） -->
                                        <Ellipse Width="29" Height="29" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="1"
                                                 Fill="Transparent" Opacity="0.10"/>
                                        <Ellipse Width="26" Height="26" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="1"
                                                 Fill="Transparent" Opacity="0.17"/>
                                        <Ellipse Width="22" Height="22" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="1"
                                                 Fill="Transparent" Opacity="0.10"/>
                                        <Ellipse x:Name="AvatarLabel" Width="16" Height="16"
                                                 Fill="{Binding SelectedCharacter, Converter={x:Static conv:CharacterAccentConverter.Instance}}"/>
                                        <!-- 对置双反光点（轨道半径 12）：对称沟纹旋转不可见，靠非对称点让
                                             慢转肉眼可辨（网易云以专辑封面非对称承担此职），静态时近乎隐形 -->
                                        <Path Fill="{DynamicResource C_FFEDEDF5}" Opacity="0.4"
                                              Data="M16.2,4.2 L17.8,4.2 L17.8,5.8 L16.2,5.8 Z M16.2,28.2 L17.8,28.2 L17.8,29.8 L16.2,29.8 Z"/>
                                        <!-- 墨色随主题：Dark 深墨（亮标签）/ Light 白墨（加深标签），同转换器供给 -->
                                        <TextBlock x:Name="AvatarLetter" Text="{Binding SelectedCharacter.DisplayName[0]}"
                                                   FontSize="10" FontWeight="700"
                                                   Foreground="{Binding SelectedCharacter, Converter={x:Static conv:CharacterAccentConverter.Instance}, ConverterParameter=ink}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="HostNameText" Text="{Binding SelectedCharacter.DisplayName}" FontSize="14" FontWeight="600"
                                           Foreground="{DynamicResource TitleText}" VerticalAlignment="Center"
                                           Classes.speaking="{Binding ChatVM.IsSpeaking}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Width="32" Height="30" Padding="0" Background="{DynamicResource C_10000000}"
                                    Command="{Binding OpenSearchCommand}" ToolTip.Tip="{DynamicResource S_SearchTab}" AutomationProperties.Name="{DynamicResource S_SearchTab}">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                            </Button>
                            <Button x:Name="SleepTimerButton" Width="32" Height="30" Padding="0" Background="{DynamicResource C_10000000}"
                                    Classes.active="{Binding IsSleepTimerActive}"
                                    ToolTip.Tip="{Binding SleepTimerTooltip}" AutomationProperties.Name="{DynamicResource S_SleepTimer}">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="M12.3,2 A10,10 0 0,0 10.4,21.8 A10,10 0 0,0 19.9,15 A8,8 0 0,1 12.3,2 Z"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="sleep-timer-flyout">
                                        <StackPanel Width="196" Spacing="6">
                                            <!-- 标题与剩余倒计时 -->
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S_SleepTimer}"
                                                           FontWeight="600" FontSize="13" Foreground="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SleepTimerDisplayStatus}"
                                                           FontSize="12" FontWeight="600" Foreground="{DynamicResource AccentGreen}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsSleepTimerActive}"/>
                                            </DockPanel>

                                            <!-- 分隔线 -->
                                            <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,2,0,2"/>

                                            <!-- 选项列表 -->
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption0Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimerOff}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption15Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>15</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimer15m}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption30Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>30</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimer30m}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption45Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>45</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimer45m}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption60Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>60</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimer60m}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOption90Selected}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>90</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimer90m}"/>
                                            </Button>
                                            <Button Classes="timer-opt" Classes.selected="{Binding IsSleepTimerOptionTrackEndSelected}"
                                                    IsEnabled="{Binding CanStopAfterCurrentTrack}"
                                                    ToolTip.Tip="{Binding StopAfterCurrentTrackTooltip}"
                                                    Command="{Binding SetSleepTimerCommand}" Click="OnSleepTimerOptionClicked">
                                                <Button.CommandParameter>
                                                    <x:Int32>-1</x:Int32>
                                                </Button.CommandParameter>
                                                <TextBlock Text="{DynamicResource S_SleepTimerEndOfTrack}"/>
                                            </Button>

                                            <!-- 分隔线 -->
                                            <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,2,0,2"/>

                                            <!-- 到期退出应用勾选 -->
                                            <CheckBox IsChecked="{Binding SleepTimerCloseAppOnExpiry, Mode=TwoWay}"
                                                      Foreground="{DynamicResource C_FFEDEDF5}" FontSize="12" Margin="4,2,0,0">
                                                <TextBlock Text="{DynamicResource S_SleepTimerCloseApp}" VerticalAlignment="Center"/>
                                            </CheckBox>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="SettingsButton" Width="32" Height="30" Padding="0" Background="{DynamicResource C_10000000}"
                                    Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{DynamicResource S_Settings}" AutomationProperties.Name="{DynamicResource S_Settings}">
                                <!-- 齿轮：实心剪影单 Path（齿块与轮缘连体、中心孔反向绕行镂空），
                                     坐标由脚本生成。两代前车之鉴：细线齿轮 15px 下齿隙被描边糊死；
                                     描边圆环+独立齿块则齿窄于隙、放射状被读成太阳 -->
                                <Path Width="15" Height="15" Stretch="None" Fill="{DynamicResource C_FFEDEDF5}" Data="M12.43,6.18 L14.41,6.40 L14.41,8.60 L12.43,8.82 L11.92,10.05 L13.16,11.61 L11.61,13.16 L10.05,11.92 L8.82,12.43 L8.60,14.41 L6.40,14.41 L6.18,12.43 L4.95,11.92 L3.39,13.16 L1.84,11.61 L3.08,10.05 L2.57,8.82 L0.59,8.60 L0.59,6.40 L2.57,6.18 L3.08,4.95 L1.84,3.39 L3.39,1.84 L4.95,3.08 L6.18,2.57 L6.40,0.59 L8.60,0.59 L8.82,2.57 L10.05,3.08 L11.61,1.84 L13.16,3.39 L11.92,4.95 Z M9.90,7.50 L9.58,6.30 L8.70,5.42 L7.50,5.10 L6.30,5.42 L5.42,6.30 L5.10,7.50 L5.42,8.70 L6.30,9.58 L7.50,9.90 L8.70,9.58 L9.58,8.70 L9.90,7.50 Z"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <local:ClockStage Grid.Row="1" DataContext="{Binding}"/>

                <local:PlayerDeck Grid.Row="2" DataContext="{Binding}"/>

                <local:ChatArea Grid.Row="3" Grid.RowSpan="2" DataContext="{Binding}"/>

                <!-- StatusBar（统一电台状态，替换原 FooterBar） -->
                <local:StatusBar Grid.Row="5" DataContext="{Binding}"/>
            </Grid>

            <Border IsVisible="{Binding IsLibraryOpen}" Background="{DynamicResource C_01000000}" PointerPressed="OnDismissOverlayPressed"/>
            <Border IsVisible="{Binding IsSettingsOpen}" Background="{DynamicResource C_01000000}" PointerPressed="OnDismissOverlayPressed"/>
            <Border IsVisible="{Binding IsCharacterPickerOpen}" Background="{DynamicResource C_01000000}" PointerPressed="OnDismissOverlayPressed"/>
            <Border IsVisible="{Binding IsCloseConfirmOpen}" Background="{DynamicResource C_01000000}" PointerPressed="OnDismissOverlayPressed"/>

            <local:PlaylistDrawer DataContext="{Binding}"/>

            <!-- Settings overlay -->
            <Border IsVisible="{Binding IsSettingsOpen}"
                    Margin="56"
                    Background="{DynamicResource C_FC0E0E15}"
                    BorderBrush="{DynamicResource C_667B7898}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource S_Settings}" FontSize="18" FontWeight="700"
                                   FontFamily="Consolas" Foreground="{DynamicResource C_FFFFFFFF}"/>
                        <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                                Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{DynamicResource S_CloseSettings}"
                                AutomationProperties.Name="{DynamicResource S_CloseSettings}">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                        </Button>
                    </Grid>
                    <!-- 滚动职责在 SettingsView 内容区（侧边导航不随内容滚动） -->
                    <local:SettingsView Grid.Row="1" DataContext="{Binding SettingsVM}"/>
                </Grid>
            </Border>

            <local:CharacterPicker DataContext="{Binding}"/>

            <!-- Close confirm dialog overlay -->
            <Border IsVisible="{Binding IsCloseConfirmOpen}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="340" MaxWidth="400"
                    Background="{DynamicResource C_FC0E0E15}"
                    BorderBrush="{DynamicResource C_667B7898}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{DynamicResource S_CloseDialogTitle}" FontSize="15" FontWeight="Bold"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"/>
                    <TextBlock Text="{DynamicResource S_CloseDialogHint}" FontSize="12"
                               Foreground="{DynamicResource C_FFB3B3B3}"/>
                    <StackPanel Spacing="10">
                        <RadioButton GroupName="CloseActionGroup" IsChecked="{Binding CloseDialogIsTray, Mode=TwoWay}"
                                     Content="{DynamicResource S_CloseActionTray}"/>
                        <RadioButton GroupName="CloseActionGroup" IsChecked="{Binding CloseDialogIsExit, Mode=TwoWay}"
                                     Content="{DynamicResource S_CloseActionExit}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding CloseDialogRemember, Mode=TwoWay}"
                              Content="{DynamicResource S_RememberChoice}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{DynamicResource S_Cancel}" Command="{Binding CancelCloseDialogCommand}"
                                Padding="14,6" FontSize="12"/>
                        <Button Content="{DynamicResource S_Confirm}" Command="{Binding ConfirmCloseDialogCommand}"
                                Background="{DynamicResource AccentGreen}" Foreground="{DynamicResource C_FF07070B}"
                                FontWeight="Bold" Padding="14,6" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Border>

        <!-- 简洁模式：两行紧凑卡，覆盖标题栏与主壳区域 -->
        <local:CompactPlayer Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsCompactMode}"/>
    </Grid>
</Window>
