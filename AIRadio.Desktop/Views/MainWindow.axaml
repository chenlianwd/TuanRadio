<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIRadio.Desktop.ViewModels"
        xmlns:models="using:AIRadio.Desktop.Models"
        xmlns:services="using:AIRadio.Desktop.Services"
        xmlns:local="using:AIRadio.Desktop.Views"
        x:Class="AIRadio.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AIRadio FM"
        Width="760" Height="760"
        MinWidth="700" MinHeight="700"
        SystemDecorations="None"
        Background="#FF030305"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <local:TabVisibleConverter x:Key="TabVisibleConverter"/>
        <local:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#11121620"/>
            <Setter Property="Foreground" Value="#FFEDEDF5"/>
            <Setter Property="BorderBrush" Value="#333A3D4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24212632"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FF07070B"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#889090A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="14"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" Background="#FF030305" RowDefinitions="30,*">
        <Border x:Name="TitleBar" Grid.Row="0" Background="#FF050507" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#FF56F5C4"/>
                    <TextBlock Text="AIRadio FM" FontSize="12" FontFamily="Consolas"
                               Foreground="#FFBFC3D6" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Width="30" Height="24" Padding="0" BorderThickness="1"
                            Background="#FF302A1B" BorderBrush="#88FFC857"
                            Foreground="#FFFFC857" Click="OnMinimizeClicked"
                            ToolTip.Tip="Minimize">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFFC857" StrokeThickness="2.4" Data="M5,12 L19,12"/>
                    </Button>
                    <Button Width="30" Height="24" Padding="0" BorderThickness="1"
                            Background="#FF321D25" BorderBrush="#88FF5F73"
                            Foreground="#FFFF5F73" Click="OnCloseClicked"
                            ToolTip.Tip="Close">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="#FFFF5F73" StrokeThickness="2.4" Data="M18,6 L6,18 M6,6 L18,18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ShellCard" Grid.Row="1"
                Margin="14"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="#F0131320"
                BorderBrush="#33494B66"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="True">
            <Grid>
            <Grid RowDefinitions="64,168,88,36,*,66,28">
                <!-- Brand header -->
                <Border x:Name="BrandHeader" Grid.Row="0" Background="#CC1B1B2A" Padding="22,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border x:Name="AvatarBorder" Width="34" Height="34" CornerRadius="17" Background="#FF262632">
                                <TextBlock x:Name="AvatarLetter" Text="{Binding SelectedCharacter.DisplayName[0]}"
                                           FontSize="15" FontWeight="700"
                                           Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="AIRadio" FontSize="24" FontWeight="700"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       Foreground="#FFEDEDF5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Width="32" Height="30" Padding="0" Background="#10000000"
                                    Command="{Binding ToggleCharacterPickerCommand}" ToolTip.Tip="DJ">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M20,21 C20,17.7 16.4,15 12,15 C7.6,15 4,17.7 4,21 M12,12 C14.2,12 16,10.2 16,8 C16,5.8 14.2,4 12,4 C9.8,4 8,5.8 8,8 C8,10.2 9.8,12 12,12"/>
                            </Button>
                            <Button Width="32" Height="30" Padding="0" Background="#10000000"
                                    Command="{Binding OpenSearchCommand}" ToolTip.Tip="Search">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                            </Button>
                            <Button Width="32" Height="30" Padding="0" Background="#10000000"
                                    Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Settings">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M4,21 L4,14 M4,10 L4,3 M12,21 L12,12 M12,8 L12,3 M20,21 L20,16 M20,12 L20,3 M2,14 L6,14 M10,8 L14,8 M18,16 L22,16"/>
                            </Button>
                            <Button x:Name="ThemeButton" Padding="10,5"
                                    Background="#10000000"
                                    Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Theme">
                                <Grid>
                                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" IsVisible="{Binding IsDarkMode}"
                                          Data="M21,12.8 C20.1,16.9 16.4,20 12,20 C7,20 3,16 3,11 C3,6.6 6.1,2.9 10.2,2 C9.4,3.2 9,4.6 9,6 C9,11 13,15 18,15 C19.1,15 20.1,14.8 21,14.4"/>
                                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FF111118" StrokeThickness="2" IsVisible="{Binding IsDarkMode, Converter={StaticResource InverseBoolConverter}}"
                                          Data="M12,4 L12,2 M12,22 L12,20 M4.9,4.9 L3.5,3.5 M20.5,20.5 L19.1,19.1 M4,12 L2,12 M22,12 L20,12 M4.9,19.1 L3.5,20.5 M20.5,3.5 L19.1,4.9 M12,17 C14.8,17 17,14.8 17,12 C17,9.2 14.8,7 12,7 C9.2,7 7,9.2 7,12 C7,14.8 9.2,17 12,17"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Clock stage -->
                <Grid x:Name="ClockStage" Grid.Row="1" Background="#F008080D">
                    <TextBlock IsHitTestVisible="False"
                               Opacity="0.20"
                               FontSize="11"
                               LineHeight="17"
                               FontFamily="Consolas"
                               Foreground="#FF44465C"
                               TextWrapping="Wrap"
                               x:Name="ClockDots"/>
                    <Grid ColumnDefinitions="*,Auto,*" Margin="24,10">
                        <local:SpectrumView Grid.Column="0" DataContext="{Binding SpectrumVM}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            Height="118" Margin="0,0,18,0"/>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#FF56F5C4" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="700" FontFamily="Consolas"
                                           Foreground="#FF56F5C4"/>
                            </StackPanel>
                            <TextBlock x:Name="ClockDisplay" Text="21:11" FontSize="56" FontWeight="700"
                                       FontFamily="Consolas" Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DayDisplay" Text="Monday" FontSize="13" FontFamily="Consolas"
                                       Foreground="#FFE5E5EC" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DateDisplay" Text="20-APR-2026" FontSize="10" FontFamily="Consolas"
                                       Foreground="#FF858594" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <local:SpectrumView Grid.Column="2" DataContext="{Binding SpectrumVM}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            Height="118" Margin="18,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- Player deck -->
                <Border x:Name="PlayerDeck" Grid.Row="2" Background="#E91B1B2A" BorderBrush="#223D3D4F" BorderThickness="0,1" Padding="22,10">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="165,*,175">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Border Width="3" Height="11" Background="#FF56F5C4" CornerRadius="2"/>
                                <Border Width="3" Height="17" Background="#FF56F5C4" CornerRadius="2"/>
                                <Border Width="3" Height="9" Background="#FF56F5C4" CornerRadius="2"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding PlayerVM.TrackTitle}" FontSize="14" FontWeight="700"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#FFFFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="128"/>
                                <TextBlock Text="{Binding PlayerVM.TrackArtist}" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#FF9A9AA8"
                                           TextTrimming="CharacterEllipsis" MaxWidth="128"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Width="34" Height="34" Command="{Binding PlayerVM.PreviousCommand}" ToolTip.Tip="上一首">
                                <PathIcon Width="16" Height="16" Data="M6,5 L6,19 M18,6 L9,12 L18,18 Z"/>
                            </Button>
                            <Button Width="38" Height="38" Background="#302B2E3C" Command="{Binding PlayerVM.PlayCommand}" ToolTip.Tip="播放/暂停">
                                <Grid>
                                    <PathIcon Width="15" Height="15" IsVisible="{Binding PlayerVM.IsPlaying, Converter={StaticResource InverseBoolConverter}}"
                                              Data="M8,5 L19,12 L8,19 Z"/>
                                    <PathIcon Width="15" Height="15" IsVisible="{Binding PlayerVM.IsPlaying}"
                                              Data="M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z"/>
                                </Grid>
                            </Button>
                            <Button Width="34" Height="34" Command="{Binding PlayerVM.NextCommand}" ToolTip.Tip="下一首">
                                <PathIcon Width="16" Height="16" Data="M18,5 L18,19 M6,6 L15,12 L6,18 Z"/>
                            </Button>
                            <Button Width="62" Height="34" Command="{Binding PlayerVM.ToggleRepeatCommand}" ToolTip.Tip="循环模式">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M17,1 L21,5 L17,9 M3,11 L3,9 C3,6.8 4.8,5 7,5 L21,5 M7,23 L3,19 L7,15 M21,13 L21,15 C21,17.2 19.2,19 17,19 L3,19"/>
                                    <TextBlock Text="{Binding PlayerVM.RepeatText}" FontSize="9"/>
                                </StackPanel>
                            </Button>
                            <Button Width="34" Height="34" Command="{Binding ToggleCurrentFavoriteCommand}" ToolTip.Tip="收藏当前歌曲">
                                <Grid>
                                    <PathIcon Width="17" Height="17" IsVisible="{Binding IsCurrentFavorite, Converter={StaticResource InverseBoolConverter}}"
                                              Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                    <PathIcon Width="17" Height="17" Foreground="#FF56F5C4" IsVisible="{Binding IsCurrentFavorite}"
                                              Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Width="32" Height="30" Padding="0" Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="Library">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"/>
                            </Button>
                            <Button Width="32" Height="30" Padding="0" Command="{Binding OpenFavoritesCommand}" ToolTip.Tip="Favorites">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                            </Button>
                            <TextBlock Text="VOL" FontSize="10" FontFamily="Consolas"
                                       Foreground="#FF8A8A96" VerticalAlignment="Center"/>
                            <Slider Width="48" Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"
                                    PointerReleased="OnVolumeSliderReleased"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="42,*,42" Margin="0,12,0,0">
                            <TextBlock Grid.Column="0" Text="{Binding PlayerVM.PositionText}" FontSize="11"
                                       FontFamily="Consolas" Foreground="#FF9A9AA6" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding PlayerVM.TotalSeconds}"
                                    Value="{Binding PlayerVM.CurrentSeconds}" PointerReleased="OnProgressSliderReleased"/>
                            <TextBlock Grid.Column="2" Text="{Binding PlayerVM.DurationText}" FontSize="11"
                                       FontFamily="Consolas" Foreground="#FF9A9AA6" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Queue strip -->
                <Border x:Name="QueueStrip" Grid.Row="3" Background="#F007070A" BorderBrush="#222B2B36" BorderThickness="0,1">
                    <Grid ColumnDefinitions="*,Auto" Margin="22,0">
                        <TextBlock Text="QUEUE" FontSize="12" FontFamily="Consolas"
                                   Foreground="#FFB7B7C7" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Width="30" Height="26" Padding="0" Click="OnImportFiles" ToolTip.Tip="Import">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                            </Button>
                            <Button Width="30" Height="26" Padding="0" Command="{Binding OpenPlaylistCommand}" ToolTip.Tip="Playlist">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L3.01,6 M3,12 L3.01,12 M3,18 L3.01,18"/>
                            </Button>
                            <Button Width="30" Height="26" Padding="0" Command="{Binding OpenSearchCommand}" ToolTip.Tip="Search">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                            </Button>
                            <TextBlock Text="{Binding PlaylistVM.Tracks.Count, StringFormat={}{0} TRACKS}"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="#FFB7B7C7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Radio room -->
                <Grid x:Name="RadioRoom" Grid.Row="4" Background="#E9161623">
                    <TextBlock IsHitTestVisible="False"
                               Opacity="0.20"
                               FontSize="11"
                               LineHeight="17"
                               FontFamily="Consolas"
                               Foreground="#FF44465C"
                               TextWrapping="Wrap"
                               x:Name="RoomDots"/>

                    <Border x:Name="LiveStrip" Background="#66111113" BorderBrush="#222F303A" BorderThickness="0,0,0,1"
                            Height="46" VerticalAlignment="Top">
                        <Grid ColumnDefinitions="*,Auto" Margin="22,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="#FF56F5C4"/>
                                <TextBlock Text="AIRadio" FontSize="16" FontFamily="Consolas"
                                           Foreground="#FFEDEDF5"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="LIVE" FontSize="12" FontFamily="Consolas"
                                       Foreground="#FF8DFFC8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="22,60,22,12">
                        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8"
                                                    HorizontalAlignment="{Binding Role, Converter={x:Static local:MessageAlignConverter.Instance}}">
                                            <TextBlock Text="{Binding SenderName}" FontSize="10"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       Foreground="#FFA783FF" Margin="0,0,0,4"/>
                                            <Border Background="#EE050507" CornerRadius="4" Padding="14,10"
                                                    MaxWidth="380">
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                           FontSize="13" LineHeight="21"
                                                           FontFamily="Microsoft YaHei UI"
                                                           Foreground="#FFFFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border IsVisible="{Binding ChatVM.IsProcessing}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="22,0,22,14"
                            Background="#EE050507"
                            BorderBrush="#3356F5C4"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="#FF56F5C4" VerticalAlignment="Center"/>
                            <TextBlock Text="Claudio is thinking..." FontSize="12"
                                       FontFamily="Consolas" Foreground="#FFB9FFE8"/>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ChatVM.IsListening}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="22,0,22,14"
                            Background="#EE050507"
                            BorderBrush="#6656F5C4"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Border Width="3" Height="8" Background="#FF56F5C4"/>
                                <Border Width="3" Height="16" Background="#FF56F5C4"/>
                                <Border Width="3" Height="11" Background="#FF56F5C4"/>
                                <Border Width="3" Height="19" Background="#FF56F5C4"/>
                            </StackPanel>
                            <TextBlock Text="Release to transcribe..." FontSize="12"
                                       FontFamily="Consolas" Foreground="#FFB9FFE8"/>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ChatVM.IsRecognizing}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="22,0,22,14"
                            Background="#EE050507"
                            BorderBrush="#66A783FF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="#FFA783FF" VerticalAlignment="Center"/>
                            <TextBlock Text="Transcribing Chinese..." FontSize="12"
                                       FontFamily="Consolas" Foreground="#FFE4D9FF"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Input -->
                <Border x:Name="InputDeck" Grid.Row="5" Background="#E91B1B2A" Padding="22,10">
                    <Grid ColumnDefinitions="*,56,50" ColumnSpacing="9">
                        <TextBox Grid.Column="0" Text="{Binding ChatVM.InputText, Mode=TwoWay}"
                                 Watermark="Say something to the DJ..." KeyDown="OnChatInputKeyDown"/>
                        <Button x:Name="MicButton" Grid.Column="1" FontSize="10"
                                Background="#33262835"
                                PointerPressed="OnMicPointerPressed"
                                PointerReleased="OnMicPointerReleased"
                                PointerCaptureLost="OnMicPointerCaptureLost"
                                ToolTip.Tip="Hold to talk">
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M12,2 C10.3,2 9,3.3 9,5 L9,11 C9,12.7 10.3,14 12,14 C13.7,14 15,12.7 15,11 L15,5 C15,3.3 13.7,2 12,2 Z M5,10 C5,13.9 8.1,17 12,17 C15.9,17 19,13.9 19,10 M12,17 L12,22 M8,22 L16,22"/>
                        </Button>
                        <Button Grid.Column="2" FontSize="11"
                                Background="#FF7F7896" Foreground="#FF111118"
                                Command="{Binding ChatVM.SendMessageCommand}"
                                ToolTip.Tip="Send">
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#FF111118" StrokeThickness="2.2" Data="M12,19 L12,5 M5,12 L12,5 L19,12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border x:Name="FooterBar" Grid.Row="6" Background="#F0222234" Padding="22,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="AIRADIO FM" FontSize="11" FontFamily="Consolas"
                                   Foreground="#FFB5B5C8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ChatVM.StatusText}" FontSize="11" FontFamily="Consolas"
                                   Foreground="#FFD8D8EA" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Border IsVisible="{Binding IsLibraryOpen}" Background="#01000000" PointerPressed="OnDismissOverlayPressed"/>
            <Border IsVisible="{Binding IsSettingsOpen}" Background="#01000000" PointerPressed="OnDismissOverlayPressed"/>
            <Border IsVisible="{Binding IsCharacterPickerOpen}" Background="#01000000" PointerPressed="OnDismissOverlayPressed"/>

            <!-- Library drawer: real playlist, favorites, search and import entry points -->
            <Border IsVisible="{Binding IsLibraryOpen}"
                    Width="455"
                    HorizontalAlignment="Right"
                    Margin="0,72,18,34"
                    Background="#FC0E0E15"
                    BorderBrush="#667B7898"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="LIBRARY" FontSize="18" FontWeight="700"
                                       FontFamily="Consolas" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="playlist / favorites / search" FontSize="11"
                                       FontFamily="Consolas" Foreground="#FF89899A"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                                Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="Close library">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Width="32" Height="28" Padding="0" Command="{Binding OpenPlaylistCommand}" ToolTip.Tip="Playlist">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M8,6 L21,6 M8,12 L21,12 M8,18 L21,18 M3,6 L3.01,6 M3,12 L3.01,12 M3,18 L3.01,18"/>
                            </Button>
                            <Button Width="32" Height="28" Padding="0" Command="{Binding OpenFavoritesCommand}" ToolTip.Tip="Favorites">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M20.8,4.6 C18.9,2.9 16,3.1 14.3,5 L12,7.3 L9.7,5 C8,3.1 5.1,2.9 3.2,4.6 C1.1,6.5 1,9.8 3,11.8 L12,21 L21,11.8 C23,9.8 22.9,6.5 20.8,4.6 Z"/>
                            </Button>
                            <Button Width="32" Height="28" Padding="0" Command="{Binding OpenSearchCommand}" ToolTip.Tip="Search">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M10,18 C14.4,18 18,14.4 18,10 C18,5.6 14.4,2 10,2 C5.6,2 2,5.6 2,10 C2,14.4 5.6,18 10,18 M16,16 L22,22"/>
                            </Button>
                            <Button Width="32" Height="28" Padding="0" Click="OnImportFiles" ToolTip.Tip="Import">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                            <TextBox Text="{Binding PlaylistVM.SearchText, Mode=TwoWay}"
                                     Watermark="Search songs..." KeyDown="OnSearchKeyDown"/>
                            <Button Grid.Column="1" Content="GO" Command="{Binding PlaylistVM.SearchCommand}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding PlaylistVM.Tracks}"
                                 SelectedItem="{Binding PlaylistVM.SelectedTrack}"
                                 IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=0}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Track">
                                    <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="#FF8E8E9C" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding IsFavorite, Converter={StaticResource FavoriteIconConverter}}"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding PlaylistVM.Favorites}"
                                 IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=1}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Track">
                                    <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="PLAY"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayFavoriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding PlaylistVM.SearchResults}"
                                 IsVisible="{Binding PlaylistVM.TabIndex, Converter={StaticResource TabVisibleConverter}, ConverterParameter=2}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="services:OnlineTrack">
                                    <Border Background="#CC202126" BorderBrush="#253D3D4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="700"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           Foreground="#FF9B9BA8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="PLAY"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.PlayOnlineCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="ADD"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).PlaylistVM.AddOnlineCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Settings overlay -->
            <Border IsVisible="{Binding IsSettingsOpen}"
                    Margin="56"
                    Background="#FC0E0E15"
                    BorderBrush="#667B7898"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="SETTINGS" FontSize="18" FontWeight="700"
                                   FontFamily="Consolas" Foreground="#FFFFFFFF"/>
                        <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                                Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Close settings">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FFEDEDF5" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <local:SettingsView DataContext="{Binding SettingsVM}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Character picker -->
            <Border IsVisible="{Binding IsCharacterPickerOpen}"
                    Width="410"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="22,58,0,0"
                    Background="#FC0E0E15"
                    BorderBrush="#667B7898"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <ItemsControl ItemsSource="{Binding Characters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:CharacterProfile">
                            <Button Margin="0,0,8,8"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectCharacterCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding DisplayName[0]}" FontWeight="700"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
