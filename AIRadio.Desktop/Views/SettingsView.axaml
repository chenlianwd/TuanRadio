<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="设置" FontSize="20" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}"/>

        <!-- LLM -->
        <StackPanel Spacing="6">
            <TextBlock Text="AI 服务" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}" FontSize="13"/>
            <ComboBox SelectedValue="{Binding SelectedProvider}"
                      ItemsSource="{Binding LlmProviders}"
                      SelectedValueBinding="{Binding Id}"
                      DisplayMemberBinding="{Binding DisplayName}"
                      HorizontalAlignment="Stretch"/>
            <TextBox Text="{Binding ApiKey, Mode=TwoWay}" Watermark="输入你的 API Key" PasswordChar="•"/>
            <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" Watermark="Base URL；留空使用该格式默认地址"/>
            <TextBox Text="{Binding Model, Mode=TwoWay}" Watermark="输入模型名称，例如 gpt-4o-mini / deepseek-chat"/>
            <Button Command="{Binding TestConnectionCommand}"
                    Content="{Binding TestConnectionButtonText}"
                    IsEnabled="{Binding !IsTesting}"
                    HorizontalAlignment="Left" Padding="18,8" FontSize="12" Background="{DynamicResource C_FF9B59B0}"
                    Foreground="{DynamicResource C_FF000000}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource C_FFFFC86B}"
                       TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Language selection -->
        <StackPanel Spacing="6">
            <TextBlock Text="AI 回复语言" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}" FontSize="13"/>
            <ComboBox SelectedValue="{Binding SelectedLanguage}"
                      ItemsSource="{Binding Languages}"
                      SelectedValueBinding="{Binding Id}"
                      DisplayMemberBinding="{Binding DisplayName}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Text="选择 AI 主播回复使用的语言，可用于英语听力练习" Foreground="{DynamicResource C_FF666666}" FontSize="11"/>
        </StackPanel>

        <!-- TTS -->
        <StackPanel Spacing="6">
            <TextBlock Text="语音播报" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}" FontSize="13"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="AI 回复自动语音播报" Foreground="{DynamicResource C_FFB3B3B3}" FontSize="12"
                           VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TtsEnabled, Mode=TwoWay}"
                              OnContent="" OffContent=""/>
            </Grid>
            <ComboBox SelectedValue="{Binding SpeechMixMode}"
                      ItemsSource="{Binding SpeechMixModes}"
                      SelectedValueBinding="{Binding Id}"
                      DisplayMemberBinding="{Binding DisplayName}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Visual effects -->
        <StackPanel Spacing="6">
            <TextBlock Text="视觉效果" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}" FontSize="13"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="星光背景随音乐呼吸" Foreground="{DynamicResource C_FFB3B3B3}" FontSize="12"
                           VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableStarfield, Mode=TwoWay}"
                              OnContent="" OffContent=""/>
            </Grid>
        </StackPanel>

        <!-- Character customization -->
        <StackPanel Spacing="8">
            <TextBlock Text="数字人设置" FontWeight="700" Foreground="{DynamicResource C_FFFFFFFF}" FontSize="13"/>

            <ComboBox SelectedItem="{Binding SelectedCharacter}"
                      ItemsSource="{Binding Characters}"
                      DisplayMemberBinding="{Binding DisplayName}"
                      HorizontalAlignment="Stretch"/>

            <StackPanel Spacing="4" Margin="0,4,0,0">
                <TextBlock Text="音色" Foreground="{DynamicResource C_FFB3B3B3}" FontSize="11"/>
                <ComboBox SelectedItem="{Binding CharacterVoice}"
                          ItemsSource="{Binding Voices}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="人格提示词" Foreground="{DynamicResource C_FFB3B3B3}" FontSize="11"/>
                <TextBox Text="{Binding CharacterPersonality, Mode=TwoWay}"
                         AcceptsReturn="True" Height="80" CornerRadius="8"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Save -->
        <Button Command="{Binding SaveCommand}" Content="保存设置"
                HorizontalAlignment="Stretch" Padding="18,12" FontSize="14"
                Background="{DynamicResource C_FF9B59B0}" Foreground="{DynamicResource C_FF000000}"/>

    </StackPanel>
</UserControl>
