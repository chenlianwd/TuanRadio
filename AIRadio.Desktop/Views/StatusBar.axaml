<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.StatusBar"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- ON AIR 灯箱：直播态（播出）与演播室开麦/录音态（.studio-live）互斥呼吸，避免同作用于 Opacity 的双动画冲突 -->
        <Style Selector="Border#StateLampBox:not(.studio-live) Ellipse#StateLampHalo.breathing">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border#StateLampBox.studio-live Ellipse#StateLampHalo">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.16"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 灯泡与状态词默认色/可见性由基础 Style 注入，确保后声明的 .studio-live 样式类可以合法覆写 -->
        <Style Selector="Ellipse#StateLampHalo">
            <Setter Property="Opacity" Value="0.32"/>
            <Setter Property="IsVisible" Value="{Binding CurrentState, Converter={x:Static conv:RadioStateLampLitConverter.Instance}}"/>
            <Setter Property="Fill">
                <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                    <Binding Path="CurrentState"/>
                    <Binding Path="IsDarkMode"/>
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="Ellipse#StateLamp">
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Fill">
                <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                    <Binding Path="CurrentState"/>
                    <Binding Path="IsDarkMode"/>
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="Ellipse#StateLamp.lit">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TextBlock#StateText">
            <Setter Property="Foreground">
                <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                    <Binding Path="CurrentState"/>
                    <Binding Path="IsDarkMode"/>
                </MultiBinding>
            </Setter>
        </Style>
        <!-- 演播室开麦/录音态（studio-live）：红灯牌边框、灯珠与字色统一覆写为 StudioOnAirColor -->
        <Style Selector="Border#StateLampBox.studio-live">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioOnAirColor}"/>
        </Style>
        <Style Selector="Border#StateLampBox.studio-live Ellipse#StateLamp">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource StudioOnAirColor}"/>
        </Style>
        <Style Selector="Border#StateLampBox.studio-live Ellipse#StateLampHalo">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Fill" Value="{DynamicResource StudioOnAirColor}"/>
        </Style>
        <Style Selector="Border#StateLampBox.studio-live TextBlock#StateText">
            <Setter Property="Foreground" Value="{DynamicResource StudioOnAirColor}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceFooter}" Padding="22,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock x:Name="StationCallSignText" Text="{Binding StationCallSign}" FontSize="11" FontFamily="Consolas"
                       Foreground="{DynamicResource ShellText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding PlaybackRecoveryMessage}"
                       IsVisible="{Binding HasPlaybackRecoveryFailure}"
                       Margin="16,0" TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource StateErrorColor}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Grid x:Name="KugouLoginPromptBar"
                  Grid.Column="1"
                  IsVisible="{Binding ShowKugouLoginPrompt}"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="6"
                  Margin="12,0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <TextBlock x:Name="KugouLoginPromptText"
                           Text="{Binding KugouLoginPromptMessage}"
                           ToolTip.Tip="{Binding KugouLoginPromptMessage}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource C_FFFFC86B}"
                           VerticalAlignment="Center"/>
                <Button x:Name="KugouLoginPromptActionButton"
                        Grid.Column="1"
                        Content="{DynamicResource S_GoToQrLoginShort}"
                        Command="{Binding OpenMusicAccountSettingsCommand}"
                        Height="20" MinHeight="20"
                        Padding="8,0"
                        FontSize="10"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"/>
                <Button x:Name="KugouLoginPromptDismissButton"
                        Grid.Column="2"
                        Content="×"
                        Command="{Binding DismissKugouLoginPromptCommand}"
                        ToolTip.Tip="{DynamicResource S_Dismiss}"
                        AutomationProperties.Name="{DynamicResource S_Dismiss}"
                        Width="20" Height="20" MinWidth="20" MinHeight="20"
                        Padding="0"
                        FontSize="11"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Grid>
            <!-- 状态灯箱（复古电台 ON AIR 指示灯）：宝石灯+同色辉光+状态词；灯色随 State*Color
                 语义 token（跟随配色主题），DJ 说话/听众录音切入演播室红灯态（.studio-live），
                 Idle 熄灯但字母常驻——真实灯箱的背光语义 -->
            <Border x:Name="StateLampBox" Grid.Column="2" Background="{DynamicResource C_EE050507}"
                    BorderBrush="{DynamicResource C_333A3D4A}" BorderThickness="1"
                    Classes.studio-live="{Binding IsStudioLive}"
                    CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="StateLampHalo" Width="14" Height="14"
                                 Classes.breathing="{Binding CurrentState, Converter={x:Static conv:RadioStateLampBreathingConverter.Instance}}"/>
                        <Ellipse x:Name="StateLamp" Width="7" Height="7"
                                 Classes.lit="{Binding CurrentState, Converter={x:Static conv:RadioStateLampLitConverter.Instance}}"/>
                    </Grid>
                    <TextBlock x:Name="StateText"
                               Text="{Binding CurrentState, Converter={x:Static conv:RadioStateToTextConverter.Instance}}"
                               FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
