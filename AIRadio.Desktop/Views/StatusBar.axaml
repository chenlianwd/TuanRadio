<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.StatusBar"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- ON AIR 灯箱：直播态（播出/主持）辉光呼吸，其余点亮态恒亮、Idle 熄灯 -->
        <Style Selector="Ellipse#StateLampHalo.breathing">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 灯泡本体：熄灭态降透明度显乳白玻璃感，点亮满亮 -->
        <Style Selector="Ellipse#StateLamp">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Ellipse#StateLamp.lit">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceFooter}" Padding="22,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="TUANRADIO FM" FontSize="11" FontFamily="Consolas"
                       Foreground="{DynamicResource ShellText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding PlaybackRecoveryMessage}"
                       IsVisible="{Binding HasPlaybackRecoveryFailure}"
                       Margin="16,0" TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource StateErrorColor}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <!-- 状态灯箱（复古电台 ON AIR 指示灯）：宝石灯+同色辉光+状态词；灯色随 State*Color
                 语义 token（跟随配色主题），Idle 熄灯但字母常驻——真实灯箱的背光语义 -->
            <Border Grid.Column="2" Background="{DynamicResource C_EE050507}"
                    BorderBrush="{DynamicResource C_333A3D4A}" BorderThickness="1"
                    CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="StateLampHalo" Width="14" Height="14" Opacity="0.32"
                                 IsVisible="{Binding CurrentState, Converter={x:Static conv:RadioStateLampLitConverter.Instance}}"
                                 Classes.breathing="{Binding CurrentState, Converter={x:Static conv:RadioStateLampBreathingConverter.Instance}}">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                                    <Binding Path="CurrentState"/>
                                    <Binding Path="IsDarkMode"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="StateLamp" Width="7" Height="7"
                                 Classes.lit="{Binding CurrentState, Converter={x:Static conv:RadioStateLampLitConverter.Instance}}">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                                    <Binding Path="CurrentState"/>
                                    <Binding Path="IsDarkMode"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="StateText"
                               Text="{Binding CurrentState, Converter={x:Static conv:RadioStateToTextConverter.Instance}}"
                               FontSize="11" FontFamily="Consolas" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <MultiBinding Converter="{x:Static conv:RadioStateToBrushConverter.Instance}">
                                <Binding Path="CurrentState"/>
                                <Binding Path="IsDarkMode"/>
                            </MultiBinding>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
