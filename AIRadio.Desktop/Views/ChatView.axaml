<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Border Background="#FF181818" CornerRadius="8" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="听众互动" FontSize="14" FontWeight="700" Foreground="#FFFFFFFF"/>
                    <Border Background="#221ED760" CornerRadius="500" Padding="8,2">
                        <TextBlock Text="在线" FontSize="10" Foreground="#FF9B59B0" FontWeight="700"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DjEmotion}" FontSize="11" Foreground="#FF535353"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Messages -->
            <Border Grid.Row="1"
                    IsVisible="{Binding ShowStatusNotice}"
                    Background="#EE050507"
                    BorderBrush="#3356F5C4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,10">
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusHeadline}" FontSize="12" FontWeight="700"
                                   Foreground="#FFB9FFE8"/>
                        <Button Grid.Column="1"
                                Command="{Binding DismissStatusNoticeCommand}"
                                Content="x"
                                Width="22" Height="22"
                                Padding="0"
                                Background="#00000000"
                                Foreground="#FFB9FFE8"
                                BorderThickness="0"
                                ToolTip.Tip="收起提示"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="#FFD8D8EA"/>
                    <TextBlock Text="{Binding StatusRecoveryHint}" FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="#FFFFC86B"/>
                </StackPanel>
            </Border>

            <Button Grid.Row="1"
                    IsVisible="{Binding ShowStatusRecall}"
                    Command="{Binding RestoreStatusNoticeCommand}"
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Margin="0,0,0,10"
                    Background="#EE050507"
                    BorderBrush="#3356F5C4"
                    BorderThickness="1"
                    CornerRadius="4"
                    ToolTip.Tip="查看语音播放提示">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="#FF56F5C4" VerticalAlignment="Center"/>
                    <TextBlock Text="VOICE" FontSize="11" Foreground="#FFB9FFE8"/>
                </StackPanel>
            </Button>

            <ScrollViewer x:Name="MessagesScroller" Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,2" Padding="14,10" CornerRadius="8" MaxWidth="420"
                                    Background="{Binding Role, Converter={StaticResource MessageRoleConverter}}"
                                    HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlignmentConverter}}">
                                <StackPanel Spacing="4">
                                    <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14"
                                               Foreground="#FFFFFFFF" LineHeight="20"
                                               FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji"/>
                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm}" FontSize="10"
                                               Foreground="#FF535353" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
                <TextBox x:Name="InputBox" Text="{Binding InputText, Mode=TwoWay}" Watermark="输入消息..."
                         KeyDown="OnInputKeyDown" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Command="{Binding ToggleConversationModeCommand}"
                        Padding="12,8" Margin="0,0,8,0" CornerRadius="500"
                        Background="{Binding IsConversationMode, Converter={StaticResource ConvModeBgConverter}}"
                        Foreground="#FFFFFFFF" ToolTip.Tip="连续对话模式">
                    <TextBlock Text="{Binding IsConversationMode, Converter={StaticResource ConvModeIconConverter}}" FontSize="16"/>
                </Button>
                <Button Grid.Column="2" Command="{Binding ToggleVoiceInputCommand}"
                        Padding="12,8" Margin="0,0,8,0" CornerRadius="500"
                        Background="{Binding IsListening, Converter={StaticResource MicBgConverter}}"
                        Foreground="#FFFFFFFF" ToolTip.Tip="语音转文字">
                    <TextBlock Text="{Binding IsListening, Converter={StaticResource MicIconConverter}}" FontSize="16"/>
                </Button>
                <Button Grid.Column="3" Command="{Binding SendMessageCommand}"
                        Content="发送" Padding="20,8" Background="#FF9B59B0"
                        Foreground="#FF000000" CornerRadius="500"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
