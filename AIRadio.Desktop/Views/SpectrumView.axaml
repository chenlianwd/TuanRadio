<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             x:Class="AIRadio.Desktop.Views.SpectrumView"
             ClipToBounds="True"
             x:DataType="vm:SpectrumViewModel">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="SpotifyBar" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="{DynamicResource C_FF9B59B0}"/>
            <GradientStop Offset="1" Color="{DynamicResource C_FF169C46}"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Bands}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:Single">
                <Border Width="5" CornerRadius="2,2,0,0"
                        Height="{Binding Converter={StaticResource SpectrumBarConverter}}"
                        Background="{StaticResource SpotifyBar}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
