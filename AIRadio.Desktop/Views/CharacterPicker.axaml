<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:models="using:AIRadio.Desktop.Models"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.CharacterPicker"
             x:DataType="vm:MainWindowViewModel">

    <Border IsVisible="{Binding IsCharacterPickerOpen}"
            Width="410" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="22,58,0,0" Background="{DynamicResource C_FC0E0E15}"
            BorderBrush="{DynamicResource C_667B7898}" BorderThickness="1" CornerRadius="12" Padding="14">
        <ItemsControl ItemsSource="{Binding Characters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:CharacterProfile">
                    <Button Margin="0,0,8,8"
                            ToolTip.Tip="{Binding Description}"
                            AutomationProperties.Name="{Binding DisplayName}"
                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectCharacterCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 首字母用主播专属识别色（与黑胶唱片头像标签同色，颜色↔主播映射贯穿） -->
                            <TextBlock Text="{Binding DisplayName[0]}" FontWeight="700"
                                       Foreground="{Binding Converter={x:Static conv:CharacterAccentConverter.Instance}}"/>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
