<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.ChatArea"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- 按住说话按钮：通过样式类驱动状态，保留 DynamicResource 绑定以跟随主题/色板切换，
             并同步图标 Path.Stroke 保证亮绿/警示底色下的对比度 -->
        <Style Selector="Button#MicButton">
            <Setter Property="Background" Value="{DynamicResource C_33262835}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FFEDEDF5}"/>
        </Style>
        <Style Selector="Button#MicButton Path">
            <Setter Property="Stroke" Value="{DynamicResource C_FFEDEDF5}"/>
        </Style>
        <Style Selector="Button#MicButton.listening">
            <Setter Property="Background" Value="{DynamicResource C_FF56F5C4}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FF050507}"/>
        </Style>
        <Style Selector="Button#MicButton.listening /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FF56F5C4}"/>
        </Style>
        <Style Selector="Button#MicButton.listening:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FF56F5C4}"/>
        </Style>
        <Style Selector="Button#MicButton.listening:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FF56F5C4}"/>
        </Style>
        <Style Selector="Button#MicButton.listening Path">
            <Setter Property="Stroke" Value="{DynamicResource C_FF050507}"/>
        </Style>
        <Style Selector="Button#MicButton.listening.cancel">
            <Setter Property="Background" Value="{DynamicResource C_FFFFC86B}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_FF050507}"/>
        </Style>
        <Style Selector="Button#MicButton.listening.cancel /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FFFFC86B}"/>
        </Style>
        <Style Selector="Button#MicButton.listening.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FFFFC86B}"/>
        </Style>
        <Style Selector="Button#MicButton.listening.cancel:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource C_FFFFC86B}"/>
        </Style>
        <Style Selector="Button#MicButton.listening.cancel Path">
            <Setter Property="Stroke" Value="{DynamicResource C_FF050507}"/>
        </Style>
        <Style Selector="Border#ListeningBadge.cancel">
            <Setter Property="BorderBrush" Value="{DynamicResource C_FFFFC86B}"/>
        </Style>
        <!-- 演播室场记条（AI DJ）与听众点歌纸条（User）语汇区分 -->
        <Style Selector="TextBlock.msg-header.user">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Border.msg-bubble.assistant">
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style Selector="Border.msg-bubble.user">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_3356F5C4}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto">
        <!-- Radio room -->
        <Grid Grid.Row="0" Background="{DynamicResource C_E9161623}" RowDefinitions="Auto,*">
            <TextBlock x:Name="RoomDots" Grid.RowSpan="2"
                       IsHitTestVisible="False" Opacity="0.20" FontSize="11"
                       LineHeight="17" FontFamily="Consolas"
                       Foreground="{DynamicResource C_FF44465C}" TextWrapping="Wrap"/>

            <Grid Grid.Row="1" Margin="22,12,22,12">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8"
                                            HorizontalAlignment="{Binding Role, Converter={x:Static conv:MessageAlignConverter.Instance}}">
                                    <TextBlock Text="{Binding HeaderText}" FontSize="10"
                                               Classes="msg-header"
                                               Classes.user="{Binding IsUser}"
                                               FontFamily="Consolas, Microsoft YaHei UI"
                                               Foreground="{DynamicResource C_FFA783FF}" Margin="0,0,0,4"/>
                                    <Border Background="{DynamicResource C_EE050507}" CornerRadius="4" Padding="14,10" MaxWidth="380"
                                            Classes="msg-bubble"
                                            Classes.assistant="{Binding IsAssistant}"
                                            Classes.user="{Binding IsUser}">
                                        <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                             FontSize="13" LineHeight="21"
                                                             FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"
                                                             SelectionBrush="{DynamicResource C_6656F5C4}"
                                                             ContextFlyout="{x:Null}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 状态提示占独立布局行避免覆盖消息，并压缩为单行省高度：全文与恢复建议放 Tooltip -->
            <Border Grid.Row="0" IsVisible="{Binding ChatVM.ShowStatusNotice}"
                    HorizontalAlignment="Right" Margin="22,8,22,0" Background="{DynamicResource C_EE050507}"
                    BorderBrush="{DynamicResource C_3356F5C4}" BorderThickness="1" CornerRadius="4"
                    Padding="12,5" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ChatVM.StatusHeadline}" FontSize="11" FontWeight="700"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFB9FFE8}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ChatVM.StatusDetail}" FontSize="11" TextTrimming="CharacterEllipsis"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFD8D8EA}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Command="{Binding ChatVM.DismissStatusNoticeCommand}"
                            Content="✕" Width="18" Height="18" Padding="0"
                            Background="{DynamicResource C_00000000}" Foreground="{DynamicResource C_FFB9FFE8}" BorderThickness="0"
                            ToolTip.Tip="{DynamicResource S_TipCollapse}" AutomationProperties.Name="{DynamicResource S_TipCollapse}"/>
                </Grid>
                <ToolTip.Tip>
                    <StackPanel MaxWidth="320" Spacing="4">
                        <TextBlock Text="{Binding ChatVM.StatusDetail}" TextWrapping="Wrap"
                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource C_FFD8D8EA}"/>
                        <TextBlock Text="{Binding ChatVM.StatusRecoveryHint}" TextWrapping="Wrap"
                                   FontFamily="Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource C_FFFFC86B}"/>
                    </StackPanel>
                </ToolTip.Tip>
            </Border>

            <Button Grid.Row="0" IsVisible="{Binding ChatVM.ShowStatusRecall}"
                    Command="{Binding ChatVM.RestoreStatusNoticeCommand}"
                    HorizontalAlignment="Right" Margin="22,10,22,0"
                    Padding="10,6" Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_3356F5C4}"
                    BorderThickness="1" CornerRadius="4" ToolTip.Tip="{DynamicResource S_TipVoiceHint}"
                    AutomationProperties.Name="{DynamicResource S_TipVoiceHint}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                    <TextBlock Text="VOICE" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource C_FFB9FFE8}"/>
                </StackPanel>
            </Button>

            <Border x:Name="ListeningBadge" Grid.Row="1" IsVisible="{Binding ChatVM.IsListening}"
                    Classes.cancel="{Binding ChatVM.IsCancellingVoice}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22,0,22,14"
                    Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_6656F5C4}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                IsVisible="{Binding !ChatVM.IsCancellingVoice}">
                        <Border Width="3" Height="8" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="16" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="11" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="19" Background="{DynamicResource C_FF56F5C4}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource S_ReleaseToTranscribe}"
                               IsVisible="{Binding !ChatVM.IsCancellingVoice}"
                               FontSize="12"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFB9FFE8}"/>
                    <TextBlock Text="{DynamicResource S_ReleaseToCancelVoice}"
                               IsVisible="{Binding ChatVM.IsCancellingVoice}"
                               FontSize="12"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFC86B}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" IsVisible="{Binding ChatVM.IsRecognizing}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22,0,22,14"
                    Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_66A783FF}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C_FFA783FF}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChatVM.RecognizingStatusText}" FontSize="12"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFE4D9FF}"/>
                </StackPanel>
            </Border>

            <!-- 回复等待窗（LLM 生成 + 语音合成期间本地模型可达十余秒）：不给可见反馈会被当成
                 没发出去。占顶部状态区（处理期状态通知恒隐藏、无争用），不落消息区右下角——
                 那里会盖住刚发出的右对齐用户气泡 -->
            <Border x:Name="ProcessingBadge" Grid.Row="0" IsVisible="{Binding ChatVM.IsProcessing}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22,10,22,0"
                    Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_3356F5C4}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource S_Responding}" FontSize="12"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFB9FFE8}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Input（顶边双线微浮雕接缝） -->
        <Border Grid.Row="1" Background="{DynamicResource C_E91B1B2A}"
                BorderBrush="{DynamicResource C_223D3D4F}" BorderThickness="0,1,0,0" Padding="22,10">
            <!-- 麦克风+SEND 同簇按键组（簇内 4px、与输入框 9px）：等宽 Grid 列下两按钮
                 中心距被列距+按钮内边距放大，观感间隔过开（用户反馈）；收窄为贴内容宽度的紧凑簇 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                <TextBox Grid.Column="0" Text="{Binding ChatVM.InputText, Mode=TwoWay}"
                         Watermark="{DynamicResource S_ChatWatermark}" KeyDown="OnChatInputKeyDown" TabIndex="10"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="MicButton" FontSize="10"
                            Classes.listening="{Binding ChatVM.IsListening}"
                            Classes.cancel="{Binding ChatVM.IsCancellingVoice}"
                            PointerCaptureLost="OnMicPointerCaptureLost"
                            ToolTip.Tip="{DynamicResource S_HoldToTalk}" AutomationProperties.Name="{DynamicResource S_HoldToTalk}">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="2" Data="M12,2 C10.3,2 9,3.3 9,5 L9,11 C9,12.7 10.3,14 12,14 C13.7,14 15,12.7 15,11 L15,5 C15,3.3 13.7,2 12,2 Z M5,10 C5,13.9 8.1,17 12,17 C15.9,17 19,13.9 19,10 M12,17 L12,22 M8,22 L16,22"/>
                    </Button>
                    <!-- 发送按键：芯片壳与 VOICE/NOPE 同族（主题感知 token，替换原紫灰圆钮的
                         硬编码 C_FF7F7896），图标用箭头——语言无关（须考虑不识英文的用户，
                         2026-11-03 用户裁决）；与麦克风同内边距、同自然宽，成对紧凑 -->
                    <Button x:Name="SendButton"
                            Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_3356F5C4}"
                            Command="{Binding ChatVM.SendMessageCommand}"
                            ToolTip.Tip="{DynamicResource S_Send}" AutomationProperties.Name="{DynamicResource S_Send}">
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource C_FFB9FFE8}" StrokeThickness="2" Data="M12,19 L12,5 M5,12 L12,5 L19,12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
