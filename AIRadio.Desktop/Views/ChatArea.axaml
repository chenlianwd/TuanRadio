<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIRadio.Desktop.ViewModels"
             xmlns:conv="using:AIRadio.Desktop.Converters"
             x:Class="AIRadio.Desktop.Views.ChatArea"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="*,Auto">
        <!-- Radio room -->
        <Grid Grid.Row="0" Background="{DynamicResource C_E9161623}" RowDefinitions="Auto,Auto,*">
            <TextBlock x:Name="RoomDots" Grid.RowSpan="3"
                       IsHitTestVisible="False" Opacity="0.20" FontSize="11"
                       LineHeight="17" FontFamily="Consolas"
                       Foreground="{DynamicResource C_FF44465C}" TextWrapping="Wrap"/>

            <Border Grid.Row="0" Background="{DynamicResource C_66111113}" BorderBrush="{DynamicResource C_222F303A}" BorderThickness="0,0,0,1"
                    Height="46" VerticalAlignment="Top">
                <Grid ColumnDefinitions="*,Auto" Margin="22,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource C_FF56F5C4}"/>
                        <TextBlock Text="TuanRadio" FontSize="16" FontFamily="Consolas" Foreground="{DynamicResource C_FFEDEDF5}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="LIVE" FontSize="12" FontFamily="Consolas"
                               Foreground="{DynamicResource C_FF8DFFC8}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="22,12,22,12">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatVM.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8"
                                            HorizontalAlignment="{Binding Role, Converter={x:Static conv:MessageAlignConverter.Instance}}">
                                    <TextBlock Text="{Binding SenderName}" FontSize="10"
                                               FontFamily="Consolas, Microsoft YaHei UI"
                                               Foreground="{DynamicResource C_FFA783FF}" Margin="0,0,0,4"/>
                                    <Border Background="{DynamicResource C_EE050507}" CornerRadius="4" Padding="14,10" MaxWidth="380">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   FontSize="13" LineHeight="21"
                                                   FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource C_FFFFFFFF}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 状态提示占独立布局行避免覆盖消息，并压缩为单行省高度：全文与恢复建议放 Tooltip -->
            <Border Grid.Row="1" IsVisible="{Binding ChatVM.ShowStatusNotice}"
                    HorizontalAlignment="Right" Margin="22,8,22,0" Background="{DynamicResource C_EE050507}"
                    BorderBrush="{DynamicResource C_3356F5C4}" BorderThickness="1" CornerRadius="4"
                    Padding="12,5" MaxWidth="460">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ChatVM.StatusHeadline}" FontSize="11" FontWeight="700"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFB9FFE8}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ChatVM.StatusDetail}" FontSize="11" TextTrimming="CharacterEllipsis"
                               FontFamily="Consolas, Microsoft YaHei UI" Foreground="{DynamicResource C_FFD8D8EA}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Command="{Binding ChatVM.DismissStatusNoticeCommand}"
                            Content="x" Width="18" Height="18" Padding="0"
                            Background="{DynamicResource C_00000000}" Foreground="{DynamicResource C_FFB9FFE8}" BorderThickness="0"
                            ToolTip.Tip="{DynamicResource S_TipCollapse}"/>
                </Grid>
                <ToolTip.Tip>
                    <StackPanel MaxWidth="320" Spacing="4">
                        <TextBlock Text="{Binding ChatVM.StatusDetail}" TextWrapping="Wrap"
                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource C_FFD8D8EA}"/>
                        <TextBlock Text="{Binding ChatVM.StatusRecoveryHint}" TextWrapping="Wrap"
                                   FontFamily="Microsoft YaHei UI" FontSize="11"
                                   Foreground="{DynamicResource C_FFFFC86B}"/>
                    </StackPanel>
                </ToolTip.Tip>
            </Border>

            <Button Grid.Row="1" IsVisible="{Binding ChatVM.ShowStatusRecall}"
                    Command="{Binding ChatVM.RestoreStatusNoticeCommand}"
                    HorizontalAlignment="Right" Margin="22,10,22,0"
                    Padding="10,6" Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_3356F5C4}"
                    BorderThickness="1" CornerRadius="4" ToolTip.Tip="{DynamicResource S_TipVoiceHint}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C_FF56F5C4}" VerticalAlignment="Center"/>
                    <TextBlock Text="VOICE" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource C_FFB9FFE8}"/>
                </StackPanel>
            </Button>

            <Border Grid.Row="2" IsVisible="{Binding ChatVM.IsListening}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22,0,22,14"
                    Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_6656F5C4}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border Width="3" Height="8" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="16" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="11" Background="{DynamicResource C_FF56F5C4}"/>
                        <Border Width="3" Height="19" Background="{DynamicResource C_FF56F5C4}"/>
                    </StackPanel>
                    <TextBlock Text="Release to transcribe..." FontSize="12"
                               FontFamily="Consolas" Foreground="{DynamicResource C_FFB9FFE8}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" IsVisible="{Binding ChatVM.IsRecognizing}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="22,0,22,14"
                    Background="{DynamicResource C_EE050507}" BorderBrush="{DynamicResource C_66A783FF}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C_FFA783FF}" VerticalAlignment="Center"/>
                    <TextBlock Text="Transcribing Chinese..." FontSize="12"
                               FontFamily="Consolas" Foreground="{DynamicResource C_FFE4D9FF}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Input -->
        <Border Grid.Row="1" Background="{DynamicResource C_E91B1B2A}" Padding="22,10">
            <Grid ColumnDefinitions="*,56,50" ColumnSpacing="9">
                <TextBox Grid.Column="0" Text="{Binding ChatVM.InputText, Mode=TwoWay}"
                         Watermark="{DynamicResource S_ChatWatermark}" KeyDown="OnChatInputKeyDown" TabIndex="10"/>
                <Button x:Name="MicButton" Grid.Column="1" FontSize="10"
                        Background="{DynamicResource C_33262835}"
                        PointerCaptureLost="OnMicPointerCaptureLost"
                        ToolTip.Tip="{DynamicResource S_HoldToTalk}" AutomationProperties.Name="Microphone">
                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource C_FFEDEDF5}" StrokeThickness="2" Data="M12,2 C10.3,2 9,3.3 9,5 L9,11 C9,12.7 10.3,14 12,14 C13.7,14 15,12.7 15,11 L15,5 C15,3.3 13.7,2 12,2 Z M5,10 C5,13.9 8.1,17 12,17 C15.9,17 19,13.9 19,10 M12,17 L12,22 M8,22 L16,22"/>
                </Button>
                <Button Grid.Column="2" FontSize="11"
                        Background="{DynamicResource C_FF7F7896}" Foreground="{DynamicResource C_FF111118}"
                        Command="{Binding ChatVM.SendMessageCommand}"
                        ToolTip.Tip="{DynamicResource S_Send}" AutomationProperties.Name="Send">
                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource C_FF111118}" StrokeThickness="2.2" Data="M12,19 L12,5 M5,12 L12,5 L19,12"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
