<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIRadio.Desktop.App"
             xmlns:local="using:AIRadio.Desktop"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AIRadio/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- 让 Slider 等 Fluent 控件的系统强调色与应用青色主题保持一致。 -->
                <ColorPaletteResources x:Key="Dark" Accent="#FF56F5C4"/>
                <ColorPaletteResources x:Key="Light" Accent="#FF178A65"/>
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
