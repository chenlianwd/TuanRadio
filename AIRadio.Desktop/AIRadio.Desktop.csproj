<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\airadio.ico</ApplicationIcon>
    <AssemblyName>AIRadio</AssemblyName>
    <Product>TuanRadio FM</Product>
    <Description>AI-powered personal radio station</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIRadio.Desktop.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 实验性 Node 音乐代理（网易/酷狗）构建开关：-p:TuanRadioEnableNodeProviders=false
         可在无 Node.js 环境构建核心；关闭后不执行 npm，也不复制代理目录 -->
    <TuanRadioEnableNodeProviders Condition="'$(TuanRadioEnableNodeProviders)' == ''">true</TuanRadioEnableNodeProviders>
  </PropertyGroup>

  <!-- npm ci 严格按 lockfile 安装且失败不留"看似完整"的 node_modules（隐藏 lockfile 仅在装完时落盘）；
       普通/CI 构建都不会隐式更新 lockfile -->
  <Target Name="NpmInstall" BeforeTargets="Build" Condition="'$(TuanRadioEnableNodeProviders)' == 'true' And !Exists('server\node_modules\.package-lock.json')">
    <Exec Command="npm ci --omit=dev" WorkingDirectory="server" />
  </Target>

  <Target Name="NpmInstallKugou" BeforeTargets="Build" Condition="'$(TuanRadioEnableNodeProviders)' == 'true' And !Exists('server-kugou\node_modules\.package-lock.json')">
    <Exec Command="npm ci --omit=dev" WorkingDirectory="server-kugou" />
  </Target>

  <ItemGroup Condition="'$(TuanRadioEnableNodeProviders)' == 'true'">
    <Content Include="server\**" Exclude="server\node_modules\.package-lock.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="server-kugou\**" Exclude="server-kugou\node_modules\.package-lock.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <!-- 传递依赖固定补丁版:修复 GHSA-xrw6-gwf8-vvr9(Avalonia.Desktop 引 0.21.2,Linux DBus 路径) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- ReactiveUI -->
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />

    <!-- Audio playback -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />

    <!-- Speech and metadata -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Diagnostics -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
  </ItemGroup>
</Project>
